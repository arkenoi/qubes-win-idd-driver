// Explicit VERSIONINFO instead of the WDK's ntverp.h/common.ver templates: the WDK route
// produced the SAME version resource on every rebuild, making identical-source rebuilds
// byte-identical - which breaks upgrades (see qidd_version.h). CI stamps qidd_version.h
// per build; local builds get the checked-in defaults.
#include <windows.h>
#include "qidd_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    QIDD_VER_MAJOR,QIDD_VER_MINOR,QIDD_VER_BUILD,QIDD_VER_REV
 PRODUCTVERSION QIDD_VER_MAJOR,QIDD_VER_MINOR,QIDD_VER_BUILD,QIDD_VER_REV
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Qubes OS (QWT-NG fork)"
            VALUE "FileDescription",  "Qubes IddCx Indirect Display Driver"
            VALUE "FileVersion",      QIDD_VER_STR
            VALUE "InternalName",     "IddSampleDriver"
            VALUE "OriginalFilename", "IddSampleDriver.dll"
            VALUE "ProductName",      "Qubes Windows Tools NG"
            VALUE "ProductVersion",   QIDD_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
