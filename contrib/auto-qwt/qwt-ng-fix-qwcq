#!/bin/bash
# Make qvm-create-windows-qube's auto-qwt work with the QWT-NG ISO, automatically.
#
# Upstream's tools/auto-qwt/install-qwt.bat globs for a single qubes-tools-*.exe|msi at
# the ISO root. QWT-NG ships an installer TREE (install.cmd + staged testsigning flow),
# so the glob matches nothing and the qube finishes provisioning with no tools installed,
# silently. This helper finds qvm-create-windows-qube installations in dom0 and replaces
# that stub with the QWT-NG-aware one shipped by this package, keeping a one-time backup
# of the original as install-qwt.bat.stock.
#
# Run by the qubes-windows-tools-ng RPM %post; safe and idempotent to run by hand any
# time (e.g. after installing qvm-create-windows-qube later than this package).
# Never exits nonzero: a missing QWCQ is a report, not an error, and an RPM scriptlet
# must not fail the transaction over it.
set -u
# Overridable so the logic can be exercised outside dom0 (a scriptlet whose only test is
# "it ran during rpm -i" is a scriptlet nobody has ever seen work).
STUB="${QWTNG_STUB:-/usr/share/qubes-windows-tools-ng/auto-qwt/install-qwt.bat}"

if [ ! -f "$STUB" ]; then
    echo "qwt-ng-fix-qwcq: shipped stub missing ($STUB) - is qubes-windows-tools-ng installed?"
    exit 0
fi

# WHERE IS IT? Do not assume. qvm-create-windows-qube is a git clone, so it lives wherever
# its owner put it, and a hardcoded list of paths is a guess dressed up as a check: measured
# 2026-08-14, a clone at ~/git/qvm-create-windows-qube made this script report "nothing to
# do" - the same silent nothing-happened the script exists to prevent (a Windows qube
# provisioned with no tools installed and no error anywhere, forum 42717 post 27).
#
# Three sources, in order of certainty, all of them evidence rather than assumption:
#   1. an explicit path given on the command line - always wins, needs no discovery;
#   2. wherever the qvm-create-windows-qube entry point actually resolves to;
#   3. a bounded search of the real home directories (read from the passwd database, not
#      globbed from /home) plus the usual system prefixes.
candidates=""
for arg in "$@"; do
    [ -d "$arg" ] && candidates="$candidates $arg"
    [ -d "$arg" ] || echo "qwt-ng-fix-qwcq: '$arg' is not a directory - ignored"
done

if entry=$(command -v qvm-create-windows-qube 2>/dev/null); then
    real=$(readlink -f "$entry" 2>/dev/null) && candidates="$candidates $(dirname "$real")"
fi

if [ -z "${candidates# }" ]; then
    roots="/root /opt /usr/local /usr/share"
    # Real home directories, whatever they are - /home is a convention, not a guarantee.
    while IFS=: read -r _u _p _uid _gid _gecos home _shell; do
        case "$home" in /|/nonexistent|/dev/null|"") continue ;; esac
        [ -d "$home" ] && roots="$roots $home"
    done < /etc/passwd
    roots=$(printf '%s\n' $roots | sort -u)
    for base in $roots; do
        while IFS= read -r hit; do
            [ -n "$hit" ] && candidates="$candidates $(dirname "$(dirname "$(dirname "$hit")")")"
        done <<EOF
$(find "$base" -maxdepth 6 -type f -path '*/tools/auto-qwt/install-qwt.bat' 2>/dev/null)
EOF
    done
fi
# De-duplicate: the argument, the entry point and the search can all name the same tree.
candidates=$(printf '%s\n' $candidates | sort -u)

patched=0 seen=0
for root in $candidates; do
    bat="$root/tools/auto-qwt/install-qwt.bat"
    [ -f "$bat" ] || continue
    seen=$((seen+1))
    if cmp -s "$bat" "$STUB"; then
        echo "qwt-ng-fix-qwcq: $bat already QWT-NG-aware"
        continue
    fi
    [ -f "$bat.stock" ] || cp -p "$bat" "$bat.stock"
    if cp "$STUB" "$bat"; then
        echo "qwt-ng-fix-qwcq: PATCHED $bat (original kept as install-qwt.bat.stock)"
        patched=$((patched+1))
    else
        echo "qwt-ng-fix-qwcq: could not write $bat - fix by hand: cp $STUB $bat"
    fi
done

if [ "$seen" = 0 ]; then
    echo "qwt-ng-fix-qwcq: no qvm-create-windows-qube installation found - nothing to do."
    echo "  Searched: an explicit path (none given), \$(command -v qvm-create-windows-qube),"
    echo "  and every home directory in /etc/passwd plus /root /opt /usr/local /usr/share."
    echo "  If your clone is somewhere else, point this at it - it takes a path:"
    echo "      qwt-ng-fix-qwcq /path/to/qvm-create-windows-qube"
    echo "  Without it, qvm-create-windows-qube provisions a Windows qube whose tools install"
    echo "  silently does nothing at all."
fi
exit 0
