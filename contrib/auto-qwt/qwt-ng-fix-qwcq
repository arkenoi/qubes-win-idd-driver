#!/bin/bash
# Make qvm-create-windows-qube's auto-qwt work with the QWT-NG ISO.
#
# THE PROBLEM. Upstream's tools/auto-qwt/install-qwt.bat globs for a single
# qubes-tools-*.exe|msi at the root of the mounted QWT ISO. QWT-NG ships an installer TREE
# (install.cmd + a staged two-reboot testsigning flow), so the glob matches nothing and the
# new qube finishes provisioning with no tools installed - silently, no error, no dialog.
# Reported from the field: forum 42717 post 27.
#
# WHERE THAT FILE LIVES, and why the first version of this script could never work: it is
# NOT in dom0. qvm-create-windows-qube's own install.sh clones the repository into a
# RESOURCES QUBE (default `windows-mgmt`, overridable with RESOURCES_QUBE) at
# /home/user/qvm-create-windows-qube, and copies ONLY the main program into dom0 as
# /usr/bin/qvm-create-windows-qube. So tools/auto-qwt/install-qwt.bat exists inside that
# qube, and this script has to reach into it - looking around dom0 for the file, however
# thoroughly, finds nothing because there is nothing there.
# Both values below are taken from install.sh and honour the same environment variable.
#
# Run by the qubes-windows-tools-ng RPM %post; safe and idempotent to run by hand any time
# (e.g. after installing qvm-create-windows-qube later than this package).
# Never exits nonzero: a missing qube is a report, not an error, and an RPM scriptlet must
# not fail the transaction over it.
set -u

STUB="${QWTNG_STUB:-/usr/share/qubes-windows-tools-ng/auto-qwt/install-qwt.bat}"
QUBE="${RESOURCES_QUBE:-windows-mgmt}"
DIR="${RESOURCES_DIR:-/home/user/qvm-create-windows-qube}"
BAT="$DIR/tools/auto-qwt/install-qwt.bat"
START=0
[ "${1:-}" = "--start" ] && START=1

say() { echo "qwt-ng-fix-qwcq: $*"; }

if [ ! -f "$STUB" ]; then
    say "shipped stub missing ($STUB) - is qubes-windows-tools-ng installed?"
    exit 0
fi

if ! qvm-check "$QUBE" >/dev/null 2>&1; then
    say "resources qube '$QUBE' does not exist - nothing to patch."
    say "  qvm-create-windows-qube keeps its repository there (see its install.sh);"
    say "  if yours is elsewhere:  RESOURCES_QUBE=<qube> qwt-ng-fix-qwcq"
    exit 0
fi

# Do NOT start a qube from an RPM scriptlet. A package install that boots a VM is a
# surprise, and on a machine with little free memory it is a failure.
if ! qvm-check --running "$QUBE" >/dev/null 2>&1 && [ "$START" = 0 ]; then
    say "resources qube '$QUBE' is not running - not starting it from here."
    say "  Run this once when convenient:  qwt-ng-fix-qwcq --start"
    exit 0
fi

if ! qvm-run -q "$QUBE" "test -f '$BAT'" 2>/dev/null; then
    say "'$QUBE' has no $BAT - qvm-create-windows-qube not cloned there?"
    say "  If your clone is elsewhere:  RESOURCES_DIR=<path> qwt-ng-fix-qwcq"
    exit 0
fi

# Already ours? Compare content rather than trusting a marker file.
current=$(qvm-run -p --no-color-output "$QUBE" "cat '$BAT'" 2>/dev/null)
if [ "$current" = "$(cat "$STUB")" ]; then
    say "$QUBE:$BAT already QWT-NG-aware"
    exit 0
fi

# One-time backup of whatever is there now, then write ours and READ IT BACK. A copy that
# reported success and did not land is exactly the silent nothing-happened this whole script
# exists to prevent.
qvm-run -q "$QUBE" "test -f '$BAT.stock' || cp -p '$BAT' '$BAT.stock'" 2>/dev/null \
    || say "warning: could not create $BAT.stock in $QUBE"

if ! qvm-run -q --pass-io "$QUBE" "cat > '$BAT'" < "$STUB" 2>/dev/null; then
    say "could not write $BAT in $QUBE - fix by hand: copy $STUB there"
    exit 0
fi

verify=$(qvm-run -p --no-color-output "$QUBE" "cat '$BAT'" 2>/dev/null)
if [ "$verify" = "$(cat "$STUB")" ]; then
    say "PATCHED $QUBE:$BAT (original kept as install-qwt.bat.stock)"
else
    say "WROTE $BAT in $QUBE but the read-back does not match - patch it by hand"
fi
exit 0
