From 6f62362e8a9bbb005715b0ec7965f063248cf6eb Mon Sep 17 00:00:00 2001
From: Qubes Windows tools dev <arkenoi@gmail.com>
Date: Sun, 2 Aug 2026 21:04:15 +0300
Subject: [PATCH] xenvif: fail the device loudly instead of livelocking on a
 stalled backend

A backend that never advances its xenbus state currently wedges the whole
guest. FrontendPrepare() and FrontendConnect() loop on
FrontendWaitForBackendXenbusStateChange(), which polls the store ring and
KeStallExecutionProcessor()s at DISPATCH_LEVEL while FrontendSetState()
holds Frontend->Lock. The 120 s cap inside the wait bounds one call, not
the outer loops, so the loops are unbounded. Measured against
qubes-mirage-firewall 0.9.5 as the netvm: the guest's vif_ioemu backend
parks at InitWait (2) forever, the frontend goes to Closing (5) inside
FrontendClose(), and the guest burns ~2 cores at DISPATCH_LEVEL with
nothing left at PASSIVE_LEVEL - no qrexec, no ACPI, no PnP progress. The
domain has to be destroyed, and nothing anywhere says why.

Add a deadline (FrontendBackendStallTimeout, default 30000 ms, 0 disables)
and a single diagnostic block, anchored on the string
XENVIF-BACKEND-STALL, naming the frontend path, the full backend path, the
backend domid, the observed and expected states by number and name, the
elapsed time, the conclusion that this is a backend fault rather than a
guest fault, and the dom0 command to inspect it. The same is recorded
under error/<frontend-path>/error in xenstore. The console is readable
from dom0 even when qrexec is dead, so this is the part that matters.

Two things this deliberately does NOT do.

First, the stall unwind in FrontendPrepare() does not go through
FrontendSetOffline(). That would call PdoRequestEject(); __FdoEnumerate()
would then IoRequestDeviceEject() the PDO, the next scan would re-create
it (the vif is still in xenstore), the new PDO would start, stall, and be
ejected again - an unbounded eject/re-create loop in which no device node
survives to carry a problem code, losing the very diagnostic this change
exists to produce. The same flag also trips the eject gate in PdoCreate().
The stall path therefore unwinds everything except the eject request, so
PdoStartDevice() fails, the node stays put, and PnP shows Code 10.

Second, the wait is bounded only where the frontend has never been
CONNECTED. On the teardown-from-CONNECTED path - device disable, driver
unload, PnP stop, qube shutdown - the backend holds the RX/TX rings and
the fragment pages as writable foreign mappings, and this wait is the only
thing that guarantees it has reached Closed and unmapped before
FrontendDisconnect() revokes those grants. Revocation failure is discarded
at every call site here, and GnttabRevokeForeignAccess() does fail when
the backend still has GTF_reading/GTF_writing set, so cutting the wait
short would free pages a slow netvm may still be writing. A netvm that
merely takes longer than the deadline to walk Connected -> Closing ->
Closed would be enough. FrontendConnect()'s loop is unbounded for the same
reason, the rings being already granted by the time it runs; both get the
diagnostic and keep waiting.

Bounding those two safely first requires making revocation failure
non-fatal-but-non-freeing (leak the page) at all of this driver's
XENBUS_GNTTAB(RevokeForeignAccess) call sites. That is a separate change.
---
 src/xenvif/frontend.c | 361 ++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 351 insertions(+), 10 deletions(-)

diff --git a/src/xenvif/frontend.c b/src/xenvif/frontend.c
index 79b04fb..f96bb48 100644
--- a/src/xenvif/frontend.c
+++ b/src/xenvif/frontend.c
@@ -83,6 +83,7 @@ struct _XENVIF_FRONTEND {
     ULONG                       NumQueues;
     BOOLEAN                     Split;
     ULONG                       DisableToeplitz;
+    ULONG                       BackendStallTimeout;
 
     PXENVIF_MAC                 Mac;
     PXENVIF_RECEIVER            Receiver;
@@ -136,6 +137,17 @@ FrontendStateName(
 
 #define FRONTEND_POOL    'NORF'
 
+// Maximum time (in ms) that a single call to
+// FrontendWaitForBackendXenbusStateChange() will wait for the backend to
+// move. This was previously a hard-coded local constant.
+#define FRONTEND_MAX_WAIT                   120000ull
+
+// Default deadline (in ms) after which a backend that has not reached the
+// state we are waiting for is declared STALLED. Overridable (and
+// disableable, by setting it to zero) via the FrontendBackendStallTimeout
+// value under the driver's Parameters key.
+#define FRONTEND_STALL_TIMEOUT_DEFAULT      30000
+
 static FORCEINLINE PVOID
 __FrontendAllocate(
     IN  ULONG   Length
@@ -257,6 +269,34 @@ FrontendSetMaxQueues(
     Info("%s: %u\n", __FrontendGetPath(Frontend), Frontend->MaxQueues);
 }
 
+static VOID
+FrontendSetStallTimeout(
+    IN  PXENVIF_FRONTEND    Frontend
+    )
+{
+    HANDLE                  ParametersKey;
+    ULONG                   BackendStallTimeout;
+    NTSTATUS                status;
+
+    // Must be read here, at PASSIVE_LEVEL. The frontend state machine
+    // itself runs at DISPATCH_LEVEL and cannot touch the registry.
+    ASSERT3U(KeGetCurrentIrql(), ==, PASSIVE_LEVEL);
+
+    Frontend->BackendStallTimeout = FRONTEND_STALL_TIMEOUT_DEFAULT;
+
+    ParametersKey = DriverGetParametersKey();
+
+    status = RegistryQueryDwordValue(ParametersKey,
+                                     "FrontendBackendStallTimeout",
+                                     &BackendStallTimeout);
+    if (NT_SUCCESS(status))
+        Frontend->BackendStallTimeout = BackendStallTimeout;
+
+    Info("%s: %ums\n",
+         __FrontendGetPath(Frontend),
+         Frontend->BackendStallTimeout);
+}
+
 static FORCEINLINE ULONG
 __FrontendGetMaxQueues(
     IN  PXENVIF_FRONTEND    Frontend
@@ -1256,6 +1296,36 @@ FrontendSetOffline(
     Trace("<====\n");
 }
 
+// As FrontendSetOffline(), but WITHOUT requesting an eject.
+//
+// FrontendSetOffline() exists for the case where the device has genuinely
+// gone away (the backend area vanished, or the backend went offline), where
+// asking PnP to eject the device node is the correct response.
+//
+// A backend that is merely STALLED has not gone away, and ejecting is
+// actively harmful: PdoRequestEject() sets Pdo->Eject, __FdoEnumerate()
+// then calls IoRequestDeviceEject(), the PDO is destroyed, the next scan
+// re-creates it (the vif is still in xenstore), the new PDO is started, it
+// stalls again... an unbounded eject/re-create loop in which no device node
+// survives long enough to show a problem code. The same flag also trips the
+// gate in PdoCreate() ("if (__PdoIsEjectRequested(Pdo)) goto fail11") if it
+// is set while the replacement PDO is being built.
+//
+// So on a stall we go offline but leave the eject request clear: the start
+// IRP fails, PnP marks the node with a start failure (Code 10), the node
+// stays put, and the reason is on the console.
+static VOID
+FrontendSetOfflineNoEject(
+    IN  PXENVIF_FRONTEND    Frontend
+    )
+{
+    Trace("====>\n");
+
+    Frontend->Online = FALSE;
+
+    Trace("<====\n");
+}
+
 static VOID
 FrontendSetXenbusState(
     IN  PXENVIF_FRONTEND    Frontend,
@@ -1334,10 +1404,120 @@ fail1:
     return status;
 }
 
+// How long may we still wait for the backend before its deadline expires?
+//
+// Returns the remaining budget in milliseconds, capped at FRONTEND_MAX_WAIT,
+// and zero once the deadline has passed. If stall detection is disabled
+// (BackendStallTimeout == 0) this always returns FRONTEND_MAX_WAIT, i.e.
+// exactly the pre-existing behaviour.
+//
+// Callers that must not be bounded (see FrontendClose()) simply ignore a
+// zero return and carry on waiting; they use it only to decide when to emit
+// the diagnostic.
+static ULONGLONG
+FrontendGetStallBudget(
+    IN      PXENVIF_FRONTEND    Frontend,
+    IN      PLARGE_INTEGER      Start,
+    OUT     PULONGLONG          Elapsed
+    )
+{
+    LARGE_INTEGER               Now;
+    ULONGLONG                   Timeout;
+
+    KeQuerySystemTime(&Now);
+    *Elapsed = (Now.QuadPart - Start->QuadPart) / 10000ull;
+
+    Timeout = Frontend->BackendStallTimeout;
+    if (Timeout == 0)
+        return FRONTEND_MAX_WAIT;
+
+    if (*Elapsed >= Timeout)
+        return 0;
+
+    Timeout -= *Elapsed;
+
+    return __min(Timeout, FRONTEND_MAX_WAIT);
+}
+
+// Emit the one and only diagnostic that explains a stalled backend.
+//
+// This is the whole point of the change: when a backend never advances, the
+// guest console (readable from dom0 even when qrexec is dead) must say so,
+// name the backend, and say whose fault it is.
+//
+// Line discipline, imposed by xenbus's log plumbing:
+//  - In a free build xen/log.c drops every line that does not begin "xen";
+//    the Error() prefix ("xenvif|FrontendStall: ") satisfies that.
+//  - LogDebugPrint() copies the line into a 256-byte slot with an unchecked
+//    RtlCopyMemory(), so every line here is kept comfortably short.
+//  - The slot ring holds 32 entries and is shared with the other xen*
+//    drivers, so this block is emitted at most ONCE per stall episode.
+//
+// Grep anchor for support and for the acceptance tests: XENVIF-BACKEND-STALL
+static VOID
+FrontendStall(
+    IN  PXENVIF_FRONTEND    Frontend,
+    IN  const CHAR          *Phase,
+    IN  XenbusState         Observed,
+    IN  XenbusState         Expected,
+    IN  ULONGLONG           Elapsed,
+    IN  const CHAR          *Action
+    )
+{
+    CHAR                    Path[sizeof ("error/device/vif/XXXXXXXXXX")];
+    NTSTATUS                status;
+
+    Error("XENVIF-BACKEND-STALL phase=%s frontend=%s\n",
+          Phase,
+          __FrontendGetPath(Frontend));
+
+    Error("XENVIF-BACKEND-STALL backend=%s domid=%u\n",
+          __FrontendGetBackendPath(Frontend),
+          __FrontendGetBackendDomain(Frontend));
+
+    Error("XENVIF-BACKEND-STALL observed=%u(%s) expected=%u(%s) elapsed=%ums\n",
+          Observed,
+          XenbusStateName(Observed),
+          Expected,
+          XenbusStateName(Expected),
+          (ULONG)Elapsed);
+
+    Error("XENVIF-BACKEND-STALL this is a BACKEND fault, not a guest fault\n");
+
+    Error("XENVIF-BACKEND-STALL dom0: xenstore-ls -f %s\n",
+          __FrontendGetBackendPath(Frontend));
+
+    Error("XENVIF-BACKEND-STALL %s\n", Action);
+
+    // Also leave a breadcrumb in xenstore, where the toolstack can find it
+    // after the fact. Same shape as FrontendEjectFailed().
+    status = RtlStringCbPrintfA(Path,
+                                sizeof (Path),
+                                "error/%s",
+                                __FrontendGetPath(Frontend));
+    if (!NT_SUCCESS(status))
+        return;
+
+    (VOID) XENBUS_STORE(Printf,
+                        &Frontend->StoreInterface,
+                        NULL,
+                        Path,
+                        "error",
+                        "XENVIF-BACKEND-STALL %s: backend %s stuck in %s (%u), expected %s (%u), after %ums",
+                        Phase,
+                        __FrontendGetBackendPath(Frontend),
+                        XenbusStateName(Observed),
+                        Observed,
+                        XenbusStateName(Expected),
+                        Expected,
+                        (ULONG)Elapsed);
+}
+
 static VOID
 FrontendWaitForBackendXenbusStateChange(
     IN      PXENVIF_FRONTEND    Frontend,
-    IN OUT  XenbusState         *State
+    IN OUT  XenbusState         *State,
+    IN      ULONGLONG           TotalTimeout
     )
 {
     KEVENT                      Event;
@@ -1347,7 +1527,6 @@ FrontendWaitForBackendXenbusStateChange(
     LARGE_INTEGER               Timeout;
     XenbusState                 Old = *State;
     NTSTATUS                    status;
-    const ULONGLONG             TotalTimeout = 120000;
 
     Trace("%s: ====> %s\n",
           __FrontendGetBackendPath(Frontend),
@@ -1452,12 +1631,36 @@ FrontendReleaseBackend(
     Trace("<=====\n");
 }
 
+// Bounded is TRUE only when the frontend has NEVER been CONNECTED.
+//
+// This distinction is a memory-safety requirement, not a stylistic one.
+//
+// On the teardown-from-CONNECTED path (device disable, driver unload, PnP
+// stop, qube shutdown) the backend HAS connected: it holds the RX and TX
+// rings and the fragment pages as writable foreign mappings. This wait is
+// the ONLY thing that guarantees the backend has reached Closed - and thus
+// unmapped - before the callers below us revoke those grants and hand the
+// pages back to non-paged pool. Revocation failure is discarded at every
+// call site in this driver ((VOID) XENBUS_GNTTAB(RevokeForeignAccess, ...)),
+// and xenbus's GnttabRevokeForeignAccess() does give up (returning
+// STATUS_UNSUCCESSFUL) when the backend still has GTF_reading/GTF_writing
+// set. Cutting this wait short therefore frees pages that a slow netvm may
+// still be writing to. A netvm that merely takes longer than the stall
+// deadline to walk Connected -> Closing -> Closed is enough to trigger it.
+// So: on that path we wait forever, and only log.
+//
+// When the frontend never connected there are no rings and no fragment
+// pages - FrontendConnect() creates them, and it either never ran or
+// already unwound them - so bounding the wait cannot free a mapped page.
 static VOID
 FrontendClose(
-    IN  PXENVIF_FRONTEND    Frontend
+    IN  PXENVIF_FRONTEND    Frontend,
+    IN  BOOLEAN             Bounded
     )
 {
     XenbusState             State;
+    LARGE_INTEGER           Start;
+    BOOLEAN                 Reported;
 
     Trace("====>\n");
 
@@ -1467,13 +1670,44 @@ FrontendClose(
                         Frontend->Watch);
     Frontend->Watch = NULL;
 
+    KeQuerySystemTime(&Start);
+    Reported = FALSE;
+
     State = XenbusStateUnknown;
     while (State != XenbusStateClosed) {
+        ULONGLONG   Budget;
+        ULONGLONG   Elapsed;
+
         if (!FrontendIsOnline(Frontend))
             break;
 
+        Budget = FrontendGetStallBudget(Frontend, &Start, &Elapsed);
+
+        if (Budget == 0) {
+            if (!Reported) {
+                FrontendStall(Frontend,
+                              (Bounded) ? "CLOSE" : "CLOSE-CONNECTED",
+                              State,
+                              XenbusStateClosed,
+                              Elapsed,
+                              (Bounded) ?
+                              "abandoning close; nothing was granted, so this is safe" :
+                              "still waiting; backend must reach CLOSED before we revoke");
+                Reported = TRUE;
+            }
+
+            if (Bounded)
+                break;
+
+            // NOT bounded: keep waiting. See the comment above this
+            // function - breaking out here would let our callers revoke
+            // grants the backend may still have mapped.
+            Budget = FRONTEND_MAX_WAIT;
+        }
+
         FrontendWaitForBackendXenbusStateChange(Frontend,
-                                                &State);
+                                                &State,
+                                                Budget);
 
         switch (State) {
         case XenbusStateUnknown:
@@ -1519,6 +1753,8 @@ FrontendPrepare(
     )
 {
     XenbusState             State;
+    LARGE_INTEGER           Start;
+    BOOLEAN                 Stalled;
     NTSTATUS                status;
 
     Trace("====>\n");
@@ -1533,13 +1769,36 @@ FrontendPrepare(
     if (!NT_SUCCESS(status))
         goto fail2;
 
+    KeQuerySystemTime(&Start);
+    Stalled = FALSE;
+
     State = XenbusStateUnknown;
     while (State != XenbusStateInitWait) {
+        ULONGLONG   Budget;
+        ULONGLONG   Elapsed;
+
         if (!FrontendIsOnline(Frontend))
             break;
 
+        // Bounding this loop is safe: nothing has been granted to the
+        // backend yet. The rings and the fragment pages are created by
+        // FrontendConnect(), which runs only after we return success.
+        Budget = FrontendGetStallBudget(Frontend, &Start, &Elapsed);
+
+        if (Budget == 0) {
+            FrontendStall(Frontend,
+                          "PREPARE",
+                          State,
+                          XenbusStateInitWait,
+                          Elapsed,
+                          "failing device start; expect Code 10, no PV network");
+            Stalled = TRUE;
+            break;
+        }
+
         FrontendWaitForBackendXenbusStateChange(Frontend,
-                                                &State);
+                                                &State,
+                                                Budget);
 
         status = STATUS_SUCCESS;
         switch (State) {
@@ -1577,6 +1836,9 @@ FrontendPrepare(
     }
 
     status = STATUS_UNSUCCESSFUL;
+    if (Stalled)
+        goto stall;
+
     if (State != XenbusStateInitWait)
         goto fail3;
 
@@ -1592,6 +1854,33 @@ FrontendPrepare(
     Trace("<====\n");
     return STATUS_SUCCESS;
 
+stall:
+    // Deliberately NOT the fail3/fail2 chain.
+    //
+    // fail2 calls FrontendSetOffline(), which calls PdoRequestEject(). For a
+    // backend that has genuinely disappeared that is right. For a backend
+    // that is merely stalled it destroys the evidence: the PDO is ejected,
+    // the next bus scan re-creates it (the vif is still in xenstore), the new
+    // PDO starts, stalls again, is ejected again - forever, with no device
+    // node ever surviving long enough to show a problem code, which is
+    // exactly the diagnostic we are trying to produce.
+    //
+    // So we unwind everything except the eject request. PdoStartDevice()
+    // then fails, PnP leaves the node in place with a start failure
+    // (Code 10), and the reason is on the console and in xenstore.
+    Error("stall\n");
+
+    FrontendReleaseBackend(Frontend);
+
+    FrontendSetOfflineNoEject(Frontend);
+
+    XENBUS_STORE(Release, &Frontend->StoreInterface);
+
+    Error("fail1 (%08x)\n", status);
+
+    Trace("<====\n");
+    return status;
+
 fail4:
     Error("fail4\n");
 
@@ -2219,6 +2508,8 @@ FrontendConnect(
 {
     XenbusState             State;
     ULONG                   Attempt;
+    LARGE_INTEGER           Start;
+    BOOLEAN                 Reported;
     NTSTATUS                status;
 
     Trace("====>\n");
@@ -2313,13 +2604,48 @@ abort:
     if (!NT_SUCCESS(status))
         goto fail8;
 
+    KeQuerySystemTime(&Start);
+    Reported = FALSE;
+
     State = XenbusStateUnknown;
     while (State != XenbusStateConnected) {
+        ULONGLONG   Budget;
+        ULONGLONG   Elapsed;
+
         if (!FrontendIsOnline(Frontend))
             break;
 
+        // DIAGNOSTIC ONLY - this loop is deliberately NOT bounded.
+        //
+        // By the time we get here ReceiverConnect() and TransmitterConnect()
+        // have already granted the rings and the fragment pages to the
+        // backend. Bailing out leads to fail9, whose unwind revokes those
+        // grants and returns the pages to non-paged pool - and revocation
+        // failure is discarded here (see the comment on FrontendClose()), so
+        // a backend that is mid-map would keep a writable mapping of freed
+        // memory. Bounding this loop safely first requires making revocation
+        // failure non-fatal-but-non-freeing (leak the page) at all 17
+        // XENBUS_GNTTAB(RevokeForeignAccess) call sites in this driver; that
+        // is a separate change. Until then we log and keep waiting.
+        Budget = FrontendGetStallBudget(Frontend, &Start, &Elapsed);
+
+        if (Budget == 0) {
+            if (!Reported) {
+                FrontendStall(Frontend,
+                              "CONNECT",
+                              State,
+                              XenbusStateConnected,
+                              Elapsed,
+                              "still waiting; rings are granted, cannot revoke yet");
+                Reported = TRUE;
+            }
+
+            Budget = FRONTEND_MAX_WAIT;
+        }
+
         FrontendWaitForBackendXenbusStateChange(Frontend,
-                                                &State);
+                                                &State,
+                                                Budget);
 
         status = STATUS_SUCCESS;
         switch (State) {
@@ -2574,7 +2900,10 @@ FrontendSetState(
                 if (NT_SUCCESS(status)) {
                     Frontend->State = FRONTEND_CONNECTED;
                 } else {
-                    FrontendClose(Frontend);
+                    // Bounded: we are still in FRONTEND_PREPARED, so the
+                    // frontend never reached CONNECTED. FrontendConnect()
+                    // has already unwound whatever it granted.
+                    FrontendClose(Frontend, TRUE);
                     Frontend->State = FRONTEND_CLOSED;
 
                     Failed = TRUE;
@@ -2583,7 +2912,8 @@ FrontendSetState(
 
             case FRONTEND_CLOSED:
             case FRONTEND_UNKNOWN:
-                FrontendClose(Frontend);
+                // Bounded: nothing was ever granted to the backend.
+                FrontendClose(Frontend, TRUE);
                 Frontend->State = FRONTEND_CLOSED;
                 break;
 
@@ -2600,7 +2930,10 @@ FrontendSetState(
                 if (NT_SUCCESS(status)) {
                     Frontend->State = FRONTEND_ENABLED;
                 } else {
-                    FrontendClose(Frontend);
+                    // NOT bounded: the backend is connected and has the
+                    // rings and fragment pages mapped. FrontendDisconnect()
+                    // below revokes them.
+                    FrontendClose(Frontend, FALSE);
                     Frontend->State = FRONTEND_CLOSED;
 
                     FrontendDisconnect(Frontend);
@@ -2611,7 +2944,12 @@ FrontendSetState(
             case FRONTEND_PREPARED:
             case FRONTEND_CLOSED:
             case FRONTEND_UNKNOWN:
-                FrontendClose(Frontend);
+                // NOT bounded. This is the ordinary teardown path - device
+                // disable, driver unload, PnP stop, qube shutdown - and the
+                // backend has the rings and fragment pages mapped. Waiting
+                // for it to reach CLOSED is what makes the revocation in
+                // FrontendDisconnect() below safe.
+                FrontendClose(Frontend, FALSE);
                 Frontend->State = FRONTEND_CLOSED;
 
                 FrontendDisconnect(Frontend);
@@ -2884,6 +3222,7 @@ FrontendInitialize(
     FdoGetStoreInterface(PdoGetFdo(Pdo), &(*Frontend)->StoreInterface);
 
     FrontendSetMaxQueues(*Frontend);
+    FrontendSetStallTimeout(*Frontend);
     (*Frontend)->Hash.Algorithm = XENVIF_PACKET_HASH_ALGORITHM_UNSPECIFIED;
 
     (*Frontend)->DisableToeplitz = 0;
@@ -2978,6 +3317,7 @@ fail6:
     (*Frontend)->DisableToeplitz = 0;
 
     RtlZeroMemory(&(*Frontend)->Hash, sizeof (XENVIF_FRONTEND_HASH));
+    (*Frontend)->BackendStallTimeout = 0;
     (*Frontend)->MaxQueues = 0;
 
     RtlZeroMemory(&(*Frontend)->StoreInterface,
@@ -3075,6 +3415,7 @@ FrontendTeardown(
     Frontend->DisableToeplitz = 0;
 
     RtlZeroMemory(&Frontend->Hash, sizeof (XENVIF_FRONTEND_HASH));
+    Frontend->BackendStallTimeout = 0;
     Frontend->MaxQueues = 0;
 
     RtlZeroMemory(&Frontend->StoreInterface,
-- 
2.55.0

