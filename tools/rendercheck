#!/usr/bin/env python3
"""rendercheck — does dom0 actually SHOW what the guest is drawing?

Stability is not the absence of crashes; it is correct pixels. Every other check in this repo
asks the agent to grade its own homework (a log line said "windows kept" while dom0 was frozen).
This asks the only honest question: capture the guest's own screen, capture what dom0 renders
for that VM, and compare the two per window.

  guest truth : guest/render-truth.ps1 (full-desktop PNG + every visible top-level window rect)
  dom0 render : tools/qtest shot       (one PNG per X window the daemon has for this VM)

Windows are matched by exact WxH (the daemon's window is the agent's announced geometry), then
compared pixel-by-pixel. Output is JSON on stdout: per-window %differing pixels and mean channel
delta, plus MISSING (guest has it, dom0 does not - the S1a class of bug: Start menu invisible)
and EXTRA (dom0 shows a window the guest no longer has - stale/ghost).

KNOWN LIMITATION (measured 2026-08-11, do not mistake it for a defect): guest truth is a crop of
the COMPOSITED desktop, while dom0's PNG is a per-window image. Any window OVERLAPPING the one
under test therefore shows up as a difference - with the Start menu open over Notepad this
reported 53% differing pixels while both sides were in fact correct. Until guest truth is
captured per-window (PrintWindow, as guest/pixel-equality.ps1 does) or occluded regions are
masked, only compare windows that are unoccluded, and treat a high pct_differing as "look at the
saved PNGs" rather than an automatic fail.

Everything from the guest is DATA. Nothing is executed; images are decoded with PIL.

Usage:  QTEST_VM=win11-fresh tools/rendercheck [--label NAME] [--outdir DIR] [--tolerance PCT]
Exit:   0 = all matched windows within tolerance and nothing missing; 1 = mismatch; 2 = harness error.
"""
import argparse, base64, io, json, os, subprocess, sys, tarfile, tempfile
from pathlib import Path

import numpy as np
from PIL import Image

HERE = Path(__file__).resolve().parent
QTEST = HERE / "qtest"
GUEST_SCRIPT = HERE.parent / "guest" / "render-truth.ps1"
INCOMING = r"C:\Users\user\Documents\QubesIncoming\{}".format(os.uname().nodename)


# Shell surfaces the agent deliberately does not map as seamless windows: dom0 draws its own
# taskbar and desktop. Their absence from a shot is correct, not a missed window. Deliberately
# a SHORT list of exact classes - anything else missing gets reported, because "we probably
# meant to drop that one" is how the Start menu going invisible stayed unnoticed.
BENIGN_UNMAPPED = {"Shell_TrayWnd", "Progman", "WorkerW", "Shell_SecondaryTrayWnd"}


def run(args, **kw):
    return subprocess.run(args, capture_output=True, text=True, timeout=kw.pop("timeout", 180), **kw)


def guest_truth(vm):
    """Push + run render-truth.ps1, return (meta, PIL.Image)."""
    env = {**os.environ, "QTEST_VM": vm}
    subprocess.run([str(QTEST), "push", str(GUEST_SCRIPT)], capture_output=True, text=True, timeout=120, env=env)
    cmd = "& '{}\\render-truth.ps1'".format(INCOMING)
    p = run([str(QTEST), "ps", cmd], env=env, timeout=300)
    out = p.stdout.replace("\x00", "")
    meta = None
    for line in out.splitlines():
        if line.startswith("RTMETA "):
            meta = json.loads(line[len("RTMETA "):])
            break
    if meta is None:
        raise RuntimeError("guest did not return RTMETA (stdout head: %r)" % out[:400])
    b64 = []
    grabbing = False
    for line in out.splitlines():
        if line.strip() == "RTIMG-BEGIN":
            grabbing = True
            continue
        if line.strip() == "RTIMG-END":
            break
        if grabbing:
            b64.append(line.strip())
    if not b64:
        raise RuntimeError("guest returned no image")
    img = Image.open(io.BytesIO(base64.b64decode("".join(b64)))).convert("RGB")
    return meta, img


def dom0_geometry(vm, workdir):
    """qtest fullshot -> (list of dom0 windows incl. override-redirect, desktop PIL.Image).

    THIS is the authoritative dom0 window list. `qtest shot` is PER-WINDOW and cannot show
    override-redirect windows at all (qtest's own comment says so) - using it alone made this
    tool report "no dom0 window for the Start menu", which was WRONG: the Start menu is
    override-redirect, so it can never appear there. Retracted 2026-08-11.
    geometry.txt columns: id x y w h override_redirect mapped name
    """
    tar_path = workdir / "fullshot.tar"
    env = {**os.environ, "QTEST_VM": vm}
    run([str(QTEST), "fullshot", str(tar_path)], env=env, timeout=180)
    if not tar_path.exists() or tar_path.stat().st_size == 0:
        return [], None
    wins, desktop = [], None
    with tarfile.open(tar_path) as tf:
        for m in tf.getmembers():
            f = tf.extractfile(m)
            if f is None:
                continue
            if m.name.endswith("geometry.txt"):
                for line in f.read().decode("utf-8", "replace").splitlines():
                    if line.startswith("#") or not line.strip():
                        continue
                    p = line.split(None, 7)
                    if len(p) < 7:
                        continue
                    wins.append({"id": p[0], "x": int(p[1]), "y": int(p[2]),
                                 "w": int(p[3]), "h": int(p[4]),
                                 "override_redirect": int(p[5]), "mapped": int(p[6]),
                                 "name": p[7] if len(p) > 7 else ""})
            elif m.name.endswith("screen.png"):
                desktop = Image.open(io.BytesIO(f.read())).convert("RGB")
    return wins, desktop


def dom0_windows(vm, workdir):
    """qtest shot -> {(w,h): [PIL.Image, ...]} keyed by size, plus the raw list."""
    tar_path = workdir / "shot.tar"
    env = {**os.environ, "QTEST_VM": vm}
    p = run([str(QTEST), "shot", str(tar_path)], env=env, timeout=180)
    if not tar_path.exists() or tar_path.stat().st_size == 0:
        raise RuntimeError("qtest shot produced nothing (VM has no mapped window?) %s" % p.stderr[:200])
    imgs = []
    with tarfile.open(tar_path) as tf:
        for m in tf.getmembers():
            if not m.isfile() or not m.name.lower().endswith(".png"):
                continue
            f = tf.extractfile(m)
            if f is None:
                continue
            imgs.append((m.name, Image.open(io.BytesIO(f.read())).convert("RGB")))
    return imgs


def compare(guest_crop, dom0_img):
    a = np.asarray(guest_crop, dtype=np.int16)
    b = np.asarray(dom0_img, dtype=np.int16)
    if a.shape != b.shape:
        return None
    diff = np.abs(a - b)
    per_px = diff.max(axis=2)
    return {
        "pct_differing": round(float((per_px > 8).mean() * 100), 3),
        "mean_delta": round(float(diff.mean()), 3),
        "max_delta": int(diff.max()),
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--label", default="render")
    ap.add_argument("--outdir", default=None, help="save captures here for eyeballing")
    ap.add_argument("--tolerance", type=float, default=2.0, help="max %% differing pixels per window")
    args = ap.parse_args()
    vm = os.environ.get("QTEST_VM", "win-idd-test")

    tmp = Path(args.outdir) if args.outdir else Path(tempfile.mkdtemp(prefix="rendercheck-"))
    tmp.mkdir(parents=True, exist_ok=True)

    try:
        meta, guest_img = guest_truth(vm)
        dom0_geom, dom0_desktop = dom0_geometry(vm, tmp)
        dom0_imgs = dom0_windows(vm, tmp)
    except Exception as e:
        print(json.dumps({"label": args.label, "error": str(e)}, indent=2))
        return 2

    guest_img.save(tmp / f"{args.label}-guest.png")
    for name, im in dom0_imgs:
        im.save(tmp / f"{args.label}-dom0-{Path(name).name}")

    sx, sy = meta["screen"]["x"], meta["screen"]["y"]
    # index guest windows by size; a window is comparable only if fully on-screen
    gwins = meta["windows"] if isinstance(meta["windows"], list) else [meta["windows"]]
    by_size = {}
    for w in gwins:
        by_size.setdefault((w["w"], w["h"]), []).append(w)

    results, unmatched_dom0 = [], []
    used = set()
    for name, im in dom0_imgs:
        key = im.size  # (w, h)
        cands = [w for w in by_size.get(key, []) if id(w) not in used]
        if not cands:
            unmatched_dom0.append({"file": name, "size": list(key)})
            continue
        gw = cands[0]
        used.add(id(gw))
        box = (gw["x"] - sx, gw["y"] - sy, gw["x"] - sx + gw["w"], gw["y"] - sy + gw["h"])
        if box[0] < 0 or box[1] < 0 or box[2] > guest_img.width or box[3] > guest_img.height:
            results.append({"window": gw["title"] or gw["class"], "hwnd": gw["hwnd"],
                            "size": list(key), "skipped": "window extends outside captured desktop"})
            continue
        cmpres = compare(guest_img.crop(box), im)
        results.append({"window": gw["title"] or gw["class"], "hwnd": gw["hwnd"],
                        "class": gw["class"], "size": list(key), **(cmpres or {"error": "shape mismatch"})})

    # Windows the guest shows that dom0 got no PNG for, ignoring the invisible/chrome classes
    # the agent intentionally drops. Reported, not judged: the suite's scenarios decide which
    # of these are ship blockers (a visible Start menu missing from dom0 IS one).
    # Missing is judged against the FULLSHOT geometry list (includes override-redirect windows),
    # falling back to per-window PNG sizes only if fullshot was unavailable.
    if dom0_geom:
        dom0_sizes = [(w["w"], w["h"]) for w in dom0_geom if w["mapped"]]
    else:
        dom0_sizes = [im.size for _, im in dom0_imgs]
    missing = []
    for w in gwins:
        if (w["w"], w["h"]) in dom0_sizes:
            continue
        if w["cloaked"] or w["w"] < 40 or w["h"] < 40:
            continue
        if w["class"] in BENIGN_UNMAPPED:
            continue
        missing.append({"window": w["title"] or w["class"], "class": w["class"],
                        "hwnd": w["hwnd"], "size": [w["w"], w["h"]], "cloaked": w["cloaked"]})

    # GHOSTS: windows dom0 still has MAPPED that no longer exist in the guest. Found live on
    # 2026-08-11 - a closed Start menu and a dismissed toast stayed painted in dom0 because the
    # agent mapped them and never sent UNMAP (agent log: SendWindowMap for 0x60058/0x50086/
    # 0x10184 with no matching SendWindowUnmap). This is the user-visible "old one is there too"
    # artifact, and it is invisible to a per-window pixel diff, so it needs its own check.
    guest_sizes = [(w["w"], w["h"]) for w in gwins]
    ghosts = []
    for w in (dom0_geom or []):
        if not w["mapped"] or w["name"] == "VMapp command":
            continue
        if (w["w"], w["h"]) not in guest_sizes:
            ghosts.append({"id": w["id"], "name": w["name"], "size": [w["w"], w["h"]],
                           "pos": [w["x"], w["y"]], "override_redirect": w["override_redirect"]})

    bad = [r for r in results if r.get("pct_differing", 0) > args.tolerance]
    report = {
        "label": args.label,
        "vm": vm,
        "guest_ts": meta["ts"],
        "screen": meta["screen"],
        "compared": results,
        "over_tolerance": bad,
        "missing_in_dom0": missing,
        "extra_in_dom0": unmatched_dom0,
        "dom0_windows": dom0_geom,
        "ghosts_in_dom0": ghosts,
        # Full enumeration, always: a window that is neither compared nor missing (filtered as
        # cloaked/tiny/benign) is invisible to the verdict, and that is exactly how a shell
        # surface disappearing from dom0 goes unnoticed. Keep the raw list in every report.
        "all_guest_windows": [
            {"class": w["class"], "title": w["title"], "size": [w["w"], w["h"]],
             "cloaked": w["cloaked"], "exstyle": w["exstyle"]} for w in gwins
        ],
        "captures": str(tmp),
        "verdict": "PASS" if not bad and not unmatched_dom0 and not ghosts else "FAIL",
    }
    print(json.dumps(report, indent=2))
    return 0 if report["verdict"] == "PASS" else 1


if __name__ == "__main__":
    sys.exit(main())
