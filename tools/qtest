#!/bin/bash
# qrexec helper CLI for driving win-idd-test from the dev qube. No dom0/admin beyond policy.
# Usage: qtest <command> [args]
#   run  <cmdline>        run a cmd.exe command line in the VM (output to stdout)
#   ps   <ps-oneliner>    run a PowerShell command (quoting is fragile -> prefer pushrun)
#   push <files...>       copy files into the VM (lands in the QubesIncoming dir)
#   pushrun <script.ps1>  push a PowerShell script and execute it from QubesIncoming
#   start|shutdown|kill   VM lifecycle via Admin API (policy-gated to this VM only)
#   state                 admin.vm.CurrentState (raw response; leading "0\x30" = OK)
#   shot [out.tar]        tar of PNGs of the VM's windows (local.WinScreenshot+<vm>)
#   fullshot [out.tar]    whole dom0 desktop + geometry (local.WinFullScreen)
#   wedge [dir]          dom0 wedge forensics for $QTEST_VM (needs dom0/13-install-...)
#   resize <WxH|query>    resize the VM's dom0 window / read geometry (local.WinResize)
set -uo pipefail

VM="${QTEST_VM:-win-idd-test}"
# Discovered in Phase 0; override via env if different.
INCOMING="${QTEST_INCOMING:-C:\\Users\\user\\Documents\\QubesIncoming\\$(hostname)}"

vmshell() { printf '%s\n' "$1" | qrexec-client-vm "$VM" qubes.VMShell; }
adm()     { qrexec-client-vm "$VM" "$1" </dev/null; echo; }

case "${1:-}" in
  run)     shift; vmshell "$*" ;;
  ps)      shift; vmshell "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$*\"" ;;
  push)    shift
           # Qubes' file-agent REFUSES to overwrite an existing name in QubesIncoming
           # ("A file named ... already exists"). Delete the targets first so re-pushing
           # an edited file during iteration just works.
           for f in "$@"; do
               b="$(basename "$f")"
               vmshell "cmd /c del /q /f \"$INCOMING\\$b\" 2>nul" >/dev/null 2>&1 || true
           done
           qvm-copy-to-vm "$VM" "$@" ;;
  pushrun) shift
           # Extra args after the script are FORWARDED to it. They used to be dropped
           # silently, so a caller passing e.g. -NoIddExpected got the default behaviour
           # and no warning (found 2026-08-07 while wiring the health gate's non-IDD mode).
           f="$1"; shift; base="$(basename "$f")"
           vmshell "cmd /c del /q /f \"$INCOMING\\$base\" 2>nul" >/dev/null 2>&1 || true
           qvm-copy-to-vm "$VM" "$f"
           vmshell "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$INCOMING\\$base\" $*" ;;
  start)    adm admin.vm.Start ;;
  shutdown) adm admin.vm.Shutdown ;;
  kill)     adm admin.vm.Kill ;;
  state)    adm admin.vm.CurrentState ;;
  fullshot) out="${2:-fullscreen.tar}"
           # Whole dom0 desktop + geometry (dom0/07-install-fullscreen-screenshot.sh):
           # the only way to see override-redirect windows and dom0-side rendering
           # defects - per-window shots cannot show either.
           qrexec-client-vm dom0 "local.WinFullScreen+$VM" </dev/null > "$out" && echo "saved $out" ;;
  wedge)   # wedge [out-dir] — dom0-side capture at the moment of a wedge, no human needed.
           # Needs dom0/13-install-wedge-forensics-service.sh installed once. Never fires
           # the NMI: bugchecking a guest stays a deliberate human action.
           dir="${2:-wedge-$(date +%Y%m%d-%H%M%S)}"
           mkdir -p "$dir"
           if qrexec-client-vm dom0 "local.WinWedgeForensics+$VM" </dev/null > "$dir/capture.tar" 2>"$dir/err.txt" \
              && [ -s "$dir/capture.tar" ]; then
               tar -xf "$dir/capture.tar" -C "$dir" 2>/dev/null
               echo "wedge forensics saved to $dir"
           else
               echo "wedge capture FAILED (service installed? see $dir/err.txt)" >&2
               exit 1
           fi ;;
  shot)    out="${2:-shots.tar}"
           # +$VM selects the target; the service gates it by the win-idd-testbed tag, so the
           # target must carry that tag (04-install-screenshot-service.sh). No baked-in VM.
           qrexec-client-vm dom0 "local.WinScreenshot+$VM" </dev/null > "$out" && echo "saved $out" ;;
  resize)  # resize <WxH|query> — resize the qube's dom0 window (client area) or read its
           # geometry. Needs dom0/10-install-resize-service.sh installed by the user first.
           req="${2:?usage: qtest resize <WxH|query>}"
           qrexec-client-vm dom0 "local.WinResize+$req" </dev/null ;;
  *) grep '^#   ' "$0" | sed 's/^#   //' >&2; exit 2 ;;
esac
