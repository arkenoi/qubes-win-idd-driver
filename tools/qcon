#!/usr/bin/env python3
"""qcon - run a command in a Windows testbed guest over the XEN PV CONSOLE.

WHY THIS EXISTS. Every other way this qube reaches a guest goes through the guest's own
qrexec agent (tools/qtest run/ps/push/pushrun), so all of them die together in the failure
class this project keeps hitting: "guest alive, qrexec dead". The PV console rides a
different transport entirely - xenbus's console ring + evtchn, serviced by dom0's
xenconsoled, terminated in the guest by xencons.sys -> xencons_monitor -> xencons_tty ->
cmd.exe. It shares no code, no service and no user session with qrexec.

WHAT STILL HAS TO BE ALIVE (this is NOT "works on any dead guest"):
  - THIS qube's qrexec to dom0. admin.vm.Console is itself a qrexec call; what it does not
    need is the GUEST's qrexec agent. dom0 opens the guest's console pty locally.
  - the guest's xencons driver and its worker. A guest deadlocked at high IRQL - the
    measured wedge here - silences this too.
  - policy: admin.vm.Console for this qube (dom0/12-install-policy-tagged.sh).

ONE ATTACHER AT A TIME. dom0's `xl console` and this tool open the same pty slave and split
the byte stream, so a concurrent attach makes this return nothing. That is why NOCONSOLE is
reported as an inconclusive result and never as "the guest is dead".

Usage:
    tools/qcon <vm> <command...>            # run in the existing console session
    QCON_USER=user QCON_PASS=... tools/qcon <vm> <cmd>   # log in first if at the prompt
    tools/qcon <vm> --raw                   # just dump whatever the console says

Exit codes: 0 output captured / 2 NOCONSOLE / 3 NEEDS_LOGIN / 4 guest not running / 5 stall.
"""
import os
import select
import signal
import subprocess
import sys
import time

DEADLINE = float(os.environ.get("QCON_DEADLINE", "45"))
STALL = float(os.environ.get("QCON_STALL", "12"))
# Overall wall-clock budget for ONE qcon invocation. It exists so no caller ever needs to wrap
# this tool in `timeout`, which is what kept destroying the instrument - see _install_signal_net.
BUDGET = float(os.environ.get("QCON_BUDGET", "600"))


def _install_signal_net():
    """Make EVERY exit path run the `finally: c.close()` that detaches the console.

    THIS IS THE BUG THAT KEPT KILLING THE CONSOLE, three separate runs of it. Wrapping qcon in
    `timeout` sends SIGTERM to the PYTHON, and Python's default SIGTERM handler exits the
    interpreter WITHOUT unwinding - so `finally` never ran, `Console.close()` never fired, and
    the `qrexec-client-vm ... admin.vm.Console` CHILD was orphaned STILL ATTACHED. dom0's console
    is one-attacher-at-a-time, so every later attach returned nothing, and the silence got
    written up as "the guest lost its console" - a guest-side conclusion drawn from a defect in
    this file. The guest was fine; the instrument was self-destructing.

    Two changes make that unrepeatable: signals become SystemExit so the finally block runs, and
    qcon enforces its own BUDGET so there is no reason to reach for `timeout` at all.
    """
    def bye(sig, _frame):
        raise SystemExit(128 + sig)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGALRM):
        try:
            signal.signal(s, bye)
        except (ValueError, OSError):
            pass
    if BUDGET > 0:
        try:
            signal.alarm(int(BUDGET))
        except (ValueError, OSError):
            pass


def vm_running(vm):
    """Terminal-state check (rule 6): a halted guest can never produce a console."""
    try:
        out = subprocess.run(["qvm-ls", "--raw-data", "--fields", "NAME,STATE"],
                             capture_output=True, text=True, timeout=60).stdout
    except Exception:
        return None                      # unknown - do not claim a terminal state
    for line in out.splitlines():
        parts = line.split("|")
        if len(parts) >= 2 and parts[0] == vm:
            # TRANSIENT COUNTS AS RUNNING HERE, and getting this wrong made this tool refuse the
            # exact case it exists for. Qubes reports Transient while it is still WAITING FOR THE
            # GUEST'S QREXEC; the domain is built, its vCPUs are executing and its console ring is
            # serviced - only qrexec is missing. That is the definition of "guest alive, qrexec
            # dead", so gating on Running alone turned the one surviving instrument into
            # "qcon: <vm> is not Running - a halted guest has no console" on a guest that was very
            # much alive (measured 2026-09-09 on the parked win10-acc wedge, four attempts).
            # Halted is still refused: a halted guest really has no console.
            return parts[1] in ("Running", "Transient")
    return False


class Console:
    def __init__(self, vm):
        self.p = subprocess.Popen(["qrexec-client-vm", vm, "admin.vm.Console"],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE)
        os.set_blocking(self.p.stdout.fileno(), False)
        self.buf = b""

    def send(self, s):
        self.p.stdin.write(s.encode())
        self.p.stdin.flush()

    def pump(self, until=None, deadline=DEADLINE, stall=STALL):
        """Three exits, and the caller is told which one (rule 6):
        'hit' the marker appeared, 'stall' nothing arrived for `stall`s, 'deadline'."""
        t0 = last = time.time()
        while True:
            if until and until.encode() in self.buf:
                return "hit"
            now = time.time()
            if now - t0 > deadline:
                return "deadline"
            if now - last > stall:
                return "stall"
            r, _, _ = select.select([self.p.stdout], [], [], 0.4)
            if r:
                d = self.p.stdout.read()
                if d:
                    self.buf += d
                    last = time.time()

    def drain_quiet(self, quiet=1.5, deadline=15):
        """Read until the console has been silent for `quiet` seconds, then discard.

        REQUIRED between commands. Syncing on a prompt character instead was the bug that
        made the first real run of this tool silently skip its command: pump(until='>')
        matched a prompt that was still trickling in from the PREVIOUS exchange, so the
        buffer was cleared at the wrong moment and the tool waited for output it had
        already thrown away. Sync on silence, and on the token itself - never on '>'.
        """
        t0 = last = time.time()
        while time.time() - t0 < deadline:
            r, _, _ = select.select([self.p.stdout], [], [], 0.3)
            if r:
                d = self.p.stdout.read()
                if d:
                    last = time.time()
                    continue
            if time.time() - last > quiet:
                break
        self.buf = b""

    def close(self):
        try:
            self.p.kill()
            self.p.wait(timeout=5)
        except Exception:
            pass


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    vm, rest = sys.argv[1], sys.argv[2:]

    running = vm_running(vm)
    if running is False:
        print(f"qcon: {vm} is not Running - a halted guest has no console", file=sys.stderr)
        return 4

    c = Console(vm)
    try:
        c.send("\r")
        c.pump(until="\n", deadline=8, stall=6)

        if not c.buf:
            # Distinguish the causes instead of lumping them into one useless verdict.
            # admin.vm.Console's dom0 script takes `flock -n -E 200`, so a second attacher -
            # including a stale lock from a killed client - exits 200, and qrexec refusal
            # exits 126. Both arrive here as "no bytes" unless the exit code is inspected.
            rc = c.p.poll()
            err = b""
            try:
                err = c.p.stderr.read() or b""
            except Exception:
                pass
            err = err.decode("utf-8", "replace").strip()
            if rc == 200:
                print("qcon: BUSY - another attacher holds the console lock "
                      "(dom0 `xl console`, or a stale lock from a killed client)",
                      file=sys.stderr)
                return 6
            if rc == 126:
                print(f"qcon: REFUSED by qrexec policy - admin.vm.Console not granted. {err}",
                      file=sys.stderr)
                return 7
            # NOT EVEN [ATTACHED] IS A STRONGER RESULT THAN "quiet", and worth saying separately.
            # dom0's console layer prints "[ATTACHED]" as soon as it binds the domain's console,
            # BEFORE the guest writes anything - a healthy guest shows "\r\n[ATTACHED]\r\n\r\n<host>
            # login: " within a second or two (measured on win11-nfy, 2026-09-09). Zero bytes means
            # the ATTACH never completed, which is a domain-level condition, not a guest-software
            # one: it is not "Windows is busy", it is "dom0 could not bind this domain's console".
            # Measured the same minute on the parked win10-acc wedge: healthy guest emitted the
            # banner, wedge emitted nothing at all, with no other attacher present.
            print(f"qcon: NOCONSOLE - no bytes at all, not even dom0's [ATTACHED] banner "
                  f"(child rc={rc} {err!r}).\n"
                  "  A healthy guest emits [ATTACHED] before the guest writes anything, so this\n"
                  "  points at the ATTACH, not at guest software. Still INCONCLUSIVE alone - check:\n"
                  "   1. is someone else attached? (dom0 `xl console` splits the same pty)\n"
                  "   2. is xencons bound in the guest? (DEV_CONS err=0 svc=xencons)\n"
                  "   3. is the guest wedged at high IRQL? then nothing user-mode answers",
                  file=sys.stderr)
            return 2

        if rest == ["--raw"]:
            sys.stdout.write(c.buf.decode("utf-8", "replace"))
            return 0

        if b"login:" in c.buf.split(b"\n")[-1] or b"login:" in c.buf[-40:]:
            user, pw = os.environ.get("QCON_USER"), os.environ.get("QCON_PASS")
            if not user:
                print("qcon: NEEDS_LOGIN - console is at the login prompt; set "
                      "QCON_USER/QCON_PASS", file=sys.stderr)
                return 3
            # PROVEN SEQUENCE (2026-09-06). Two things made this look like a dead write path
            # when it is not: a fresh pty has no scrollback, so the prompt must be woken with a
            # bare CR before anything is typed; and the waits must be generous, because a
            # Windows login takes seconds. Without the CR the first send lands before any prompt
            # exists and the old 10 s "assword" wait then expired, whose only symptom was
            # "markers not seen (pump exit: stall)" - indistinguishable from a console that does
            # not accept input. It does: this yields a full shell on a guest with no qrexec.
            # THE WAKE CR AND THE login: WAIT ARE BOTH GONE, and both were doing harm.
            # pump(until=X) returns "hit" the moment X is ALREADY in the buffer and never clears
            # it - and we only reach this branch because "login:" IS in the buffer - so that wait
            # was a guaranteed no-op that merely looked like synchronisation. The CR before it then
            # made the guest emit a SECOND login prompt, so the buffer held two, and the first
            # "assword" wait could match against the wrong exchange.
            #
            # MEASURED 2026-09-09 against win11-nfy, driving the console by hand: sending the user
            # name straight into the prompt that is already there yields "password prompt seen:
            # True", "shell prompt seen: True", and a command whose output comes back
            # ("CONSOLE_WORKS" + a C:\Users\user> prompt) - first try, in seconds. The old sequence
            # was being run with QCON_LOGIN_DEADLINE up to 300 s and still failing, which is the
            # tell that it was wrong rather than slow.
            ld = float(os.environ.get("QCON_LOGIN_DEADLINE", "45"))
            c.send(user + "\r")
            if c.pump(until="assword", deadline=ld, stall=ld) != "hit":
                print("qcon: no password prompt after the user name "
                      "(raise QCON_LOGIN_DEADLINE)", file=sys.stderr)
            c.send((pw or "") + "\r")
            c.pump(until=">", deadline=ld, stall=ld)

        # Token built in the guest so the ECHOED input line can never contain the literal
        # marker - otherwise the terminal's echo of what we typed is mistaken for output.
        tok = os.urandom(4).hex().upper()
        c.drain_quiet()
        c.send(f"set QT={tok}\r")
        # Sync on the TOKEN's own echo, which cannot be left over from a previous exchange.
        if c.pump(until=tok, deadline=15, stall=10) != "hit":
            print("qcon: console did not echo the token - input is not reaching the shell",
                  file=sys.stderr)
            return 5
        c.drain_quiet()
        c.send("echo B-%QT%&" + " ".join(rest) + "&echo E-%QT%\r")
        why = c.pump(until=f"E-{tok}")
        text = c.buf.decode("utf-8", "replace")

        b, e = text.find(f"B-{tok}"), text.rfind(f"E-{tok}")
        if b < 0 or e < 0:
            print(f"qcon: markers not seen (pump exit: {why}); raw transcript follows",
                  file=sys.stderr)
            sys.stdout.write(text)
            return 5
        sys.stdout.write(text[b + len(tok) + 2:e].strip("\r\n") + "\n")
        return 0
    finally:
        c.close()


if __name__ == "__main__":
    _install_signal_net()
    sys.exit(main())
