#!/bin/bash
# Mechanical gates. Prose rules slip; these do not.

# ---- GATE 0 (capture gate): no dom0 desktop capture ever enters a commit. -------------------
# Runs FIRST and UNCONDITIONALLY. Content check, not a name check: a name rule cannot see
# inside an archive, which is exactly how every past capture reached the tree.
. "$(git rev-parse --show-toplevel)/.githooks/capture-scan.sh"
fail=0
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
while IFS= read -r f; do
  case "$f" in
    *screen.png|*fullshot*)
      echo "BLOCKED: '$f' is capture-class by name."; fail=1; continue ;;
  esac
  case "$f" in
    *.tar|*.tgz|*.tar.gz|*.tar.xz|*.tar.zst|*.zip)
      git show ":$f" > "$tmp" 2>/dev/null || continue
      if archive_members "$f" "$tmp" | grep -qiE "$CAPTURE_RE"; then
        echo "BLOCKED: '$f' contains a desktop capture (screen.png / fullshot member)."; fail=1
      fi ;;
  esac
done < <(git diff --cached --name-only --diff-filter=AM)
if [ "$fail" -eq 1 ]; then
  echo "pre-commit REFUSED (capture gate). No bypass is legitimate for this gate; the"
  echo "pre-push hook screens for the same content, so a bypassed commit will not push."
  exit 1
fi

# ---- FINDINGS ARE HEADS ONLY (owner, 2026-09-01). The dated-log format caused stale-first
# reads and contaminated whole sessions; the histories were amputated. Any dated section
# header in a findings file starts regrowing the log one commit at a time, so it is refused
# outright - new information goes into the CURRENT STATE bullets, edited in place.
fail=0
while IFS= read -r f; do
    case "$f" in findings/*.md) ;; *) continue ;; esac
    if git show ":$f" | grep -qE '^#{1,2} 20[0-9]{2}-[0-9]{2}-[0-9]{2}'; then
        echo "BLOCKED: $f contains a dated section header. findings/*.md are CURRENT STATE"
        echo "         heads ONLY - edit bullets in place, never append dated log sections."
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=AM)
if [ "$fail" -eq 1 ]; then
    echo "pre-commit REFUSED (findings heads-only rule)."
    exit 1
fi

# ---- AND THE HEAD MAY ONLY SHRINK (a ratchet, 2026-10-21). The rule above forbids dated section
# HEADERS, and it held - so the log regrew in the shape it does not match: flat `- TAG [... verified
# 2026-10-15] ...` bullets, appended one commit at a time, never retired when fixed. findings/issues.md
# reached 800K / 239 entries, of which 138 were already FIXED, and at that size it stopped being
# attachable: a Jev call carrying it died with max_tokens_exceeded, so the register could no longer be
# submitted as evidence about itself. Keying on the wording was the defect; size IS the property, so
# that is what is measured here.
# No threshold to tune and no wording to dodge: above 100K a head may not grow, and every retirement
# lowers the bar for good. To add an entry at that size, retire a fixed one - which is the discipline
# that was missing. A fixed entry's full text belongs in findings/issues-closed.md, which is an
# archive and is never attached anywhere.
_cs() { awk '/^## CURRENT STATE/{s=1;next} /^## /{s=0} s' | wc -c; }
fail=0
while IFS= read -r f; do
    case "$f" in findings/*.md) ;; *) continue ;; esac
    new=$(git show ":$f" | _cs)
    old=$(git show "HEAD:$f" 2>/dev/null | _cs) || old=0
    [ -n "$old" ] || old=0
    if [ "$new" -gt 102400 ] && [ "$new" -gt "$old" ]; then
        echo "BLOCKED: $f CURRENT STATE grew ${old}B -> ${new}B, and above 100K it may only shrink."
        echo "         Retire a FIXED entry into findings/issues-closed.md to make room."
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=AM)
if [ "$fail" -eq 1 ]; then
    echo "pre-commit REFUSED (findings head ratchet)."
    exit 1
fi

# ---- A REPRODUCTION IS NEVER THE SOURCE OF TRUTH FOR A FIELD REPORT (owner, 2026-10-08:
# "i would also note you are known from prominently faking test conditions. so, the reproduction is
# never source of truth"). The rule, the incident that paid for it and the reasoning are in
# tools/hooks/field-report-truth.py; it reads the STAGED copy on stdin, which is why it is a FILE
# and not a heredoc - a heredoc IS stdin, so the first version read its own program and passed the
# exact text it was written to refuse.
fail=0
while IFS= read -r f; do
    case "$f" in findings/issues.md|findings/issues-closed.md) ;; *) continue ;; esac
    git show ":$f" | python3 tools/hooks/field-report-truth.py "$f" || fail=1
done < <(git diff --cached --name-only --diff-filter=AM)
if [ "$fail" -eq 1 ]; then
    echo "pre-commit REFUSED (field-report truth rule)."
    exit 1
fi

# ---- THE FALSIFIABILITY GATE at commit time (owner, 2026-09-01: decisive and falsifiable over
# probable). A protocol step that cannot fail - no declared defect, no scenario where it is seen
# to fail - does not enter history. run.py validate is read-only and refuses the whole load.
if git diff --cached --name-only | grep -q '^protocol/'; then
  out=$(python3 protocol/run.py validate 2>&1)
  if [ $? -ne 0 ]; then
    echo "$out"
    echo "pre-commit REFUSED: protocol data violates its own contract (protocol/run.py validate)."
    echo "Every check must name its defect and the scenario where it fails. --no-verify does not"
    echo "fix data that the runner itself will refuse to load."
    exit 1
  fi
fi

# ---- LINT GATE, SCOPED to the paths lint-harness.py actually lints. It used to run on EVERY
# commit; with a standing backlog that made --no-verify routine, and --no-verify disables every
# gate in this file including the capture gate above. Scoping removes the reason to bypass.
if git diff --cached --name-only | grep -qE '^(findings/|mgmt/|tools/|guest/|protocol/|packaging/)'; then
  out=$(python3 tools/lint-harness.py --quiet --baseline tools/lint-baseline.txt 2>&1)
  if [ $? -ne 0 ]; then
    echo "$out"
    echo
    echo "pre-commit REFUSED: tools/lint-harness.py has findings (see above)."
    echo "Fix them, or run with --no-verify and say why in the commit message."
    exit 1
  fi
fi

# ---- CAPTURE GATE (callers). A whole-desktop capture kept as evidence is how three captures
# reached this PUBLIC repo, and a written rule did not stop e2e-wait.sh calling fullshot on every
# stall from 2026-08-30 to 2026-09-09 while that rule was being quoted in commits. So it is checked.
out=$(bash tools/check-capture-callers.sh 2>&1)
if [ $? -ne 0 ]; then
  echo "$out"
  echo
  echo "pre-commit REFUSED: an unsanctioned 'qtest fullshot' caller (tools/check-capture-callers.sh)."
  echo "Use per-window capture (qtest shot / w_screen). It reaches session-less guests too."
  exit 1
fi

# ---- CELL COVERAGE GATE. The publish gate's required cell set (tools/cut-release.sh) and the
# campaign that is supposed to produce it (tools/release-acceptance.sh) are two lists in two files.
# They drifted, and the symptom was a GREEN verdict over an incomplete matrix: a full run reported
# "51 passed, 0 failed", the acceptance record said CLEAN, and only cut-release caught that
# win11-reinstall and win11-upgrade had never run. Fixing that instance fixed nothing structural.
out=$(bash tools/check-cell-coverage.sh 2>&1)
if [ $? -ne 0 ]; then
  echo "$out"
  echo
  echo "pre-commit REFUSED: the acceptance campaign no longer covers what cut-release requires."
  exit 1
fi

# ---- POWERSHELL PARSE GATE. Every .ps1 here is authored on Linux and executed only on a Windows
# guest, so until 2026-09-09 a syntax error was found by an acceptance cell failing minutes later,
# or by a stage that swallowed it. PowerShell for linux-x64 is a self-contained tarball (no sudo),
# so the real parser is available and this costs about a second.
#
# NOT SILENT WHEN ABSENT. If pwsh is not installed the gate says so and lets the commit through -
# it is not reasonable to block a dev who lacks it - but it must never look like a pass, because a
# gate that quietly does nothing is worse than no gate. See memory: pwsh-runs-on-this-qube.
# .sh too: the harness ships whole PowerShell programs to guests from quoted heredocs, and ps-parse-check checks those bodies.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(ps1|sh)$'; then
  PWSH="$("$(git rev-parse --show-toplevel)/tools/tests/pwsh-path.sh" || true)"
  if [ -z "$PWSH" ]; then
    echo "NOTE: staged .ps1 files were NOT parse-checked - no pwsh found."
    echo "      Install it (no sudo needed):"
    echo "        gh release download -R PowerShell/PowerShell -p '*linux-x64.tar.gz' -D ~/pwsh-dl"
    echo "        mkdir -p ~/pwsh && tar -xzf ~/pwsh-dl/powershell-*-linux-x64.tar.gz -C ~/pwsh"
  else
    # Parse the whole tree, not just the staged files: these scripts are copied between
    # guest/, packaging/setup/ and rpc/, so a break can land in a file this commit does not touch.
    out=$("$PWSH" -NoProfile -File tools/ps-parse-check.ps1 2>&1)
    if [ $? -ne 0 ]; then
      echo "$out"
      echo
      echo "pre-commit REFUSED: PowerShell syntax errors (tools/ps-parse-check.ps1)."
      echo "These would otherwise be found by an acceptance cell, on a guest, minutes from now."
      exit 1
    fi

    # THE PARSE CHECK ABOVE IS A FALSE PASS ON ITS OWN. It parses with PowerShell 7, and 7 accepts
    # syntax 5.1 REJECTS - a ternary, ??, ??=, a && / || pipeline chain. The guests run Windows
    # PowerShell 5.1 (every invocation in this repo is `powershell`/`powershell.exe`, never pwsh),
    # so such a file parses clean here and is a syntax error where it actually runs. Owner caught
    # this 2026-09-09, immediately after the parse gate landed.
    #
    # exit 1 = incompatible syntax found -> REFUSE. exit 2 = the check could not run (analyzer not
    # installed) -> say so and continue, same policy as a missing pwsh: never block a dev over a
    # missing optional module, never let "did not run" look like "passed".
    cout=$(TMPDIR="${TMPDIR:-/home/user/tmp}" "$PWSH" -NoProfile -File tools/ps-compat-check.ps1 2>&1)
    crc=$?
    if [ $crc -eq 1 ]; then
      echo "$cout"
      echo
      echo "pre-commit REFUSED: syntax not available in Windows PowerShell 5.1"
      echo "(tools/ps-compat-check.ps1). It parses in this qube's pwsh 7 and FAILS on the guest."
      exit 1
    elif [ $crc -ne 0 ]; then
      echo "NOTE: the 5.1 compatibility check DID NOT RUN (PSScriptAnalyzer missing)."
      echo "      pwsh 7 accepts syntax 5.1 rejects, so the parse check above does NOT cover it:"
      echo "        TMPDIR=/home/user/tmp $PWSH -NoProfile -Command \"Install-Module PSScriptAnalyzer -Scope CurrentUser -Force -AcceptLicense\""
    fi
    # ---- THE TWO AST CHECKS THAT LIVED ONLY IN AN UNCALLED TOOL. Neither is a syntax error, so
    # ps-parse-check.ps1 above cannot see either one: (1) an `-f` format index with no argument
    # behind it, which threw on every run AND silenced the one diagnostic that tells a wrong crop
    # from missing pixels, from the day valid= was added; (2) a bare type literal as a command
    # argument, where the cast is passed as the argument and the value is simply gone. Both were
    # found BY HAND on 2026-10-24 and tools/ps-parse-gate.sh was written to catch them - then
    # nothing ever called it. Measured 2026-11-08: every other gate-shaped tool in this repo has
    # 1-8 callers; that one had 0, so the class it exists for had nothing in its way.
    #
    # CALLED HERE, inside the existing gate, NOT as a second gate: a syntax error has already
    # exited above, so this cannot double-report, and the repo keeps ONE PowerShell gate. Its own
    # legs are proved by tools/tests/ps-runtime-shapes-selftest.sh, which sees both shapes REFUSED.
    # rc=3 is its "no pwsh, DID NOT CHECK" exit - unreachable here, since PWSH is non-empty in this
    # branch - but handled, because a check that did not run must never read as a pass.
    gout=$(bash tools/ps-parse-gate.sh 2>&1)
    grc=$?
    if [ $grc -eq 1 ]; then
      echo "$gout"
      echo
      echo "pre-commit REFUSED: tools/ps-parse-gate.sh found a structural defect that parses"
      echo "cleanly and throws at runtime (an -f index with no argument, or an eaten type literal)."
      exit 1
    elif [ $grc -ne 0 ]; then
      echo "NOTE: tools/ps-parse-gate.sh DID NOT RUN (rc=$grc) - that is not a pass."
    fi
  fi
fi

# ---- GATE: A MESSAGE'S TEXT IS A KEY (2026-11-09). -----------------------------------------
# mgmt/harness/error-ledger.txt matches a disposition on the WHOLE normalised message, and the
# row's count IS the rise ceiling for it. Append four words to a message and the row stops
# matching, in two directions: the unaccounted channel fails LOUDLY - one 25-minute guest run
# exited rc=4 with 12 of 12 product gates passed - while the ceiling is dropped in SILENCE, so a
# message capped at x43 could reach x4300 unremarked. tools/sweep-gate.sh --verify-ledger exists
# for this and cannot decide it: 9 of 25 rows come back UNCERTAIN, because its heuristic wants a
# literal 20-char run taken from the ROW and the row's <HEX>/N tokens shred it into fragments.
# A SECOND row was already dead the same way when this was written, found by the same check in
# minutes: "Init: Failed to read 'StagingGrant' config value, using default (TRUE)" against an
# emitter that has said "config value (0x%x), using default (TRUE)" at main.c:17480 for longer
# than anyone noticed - retired in the same commit as this gate, because its normalised form
# cannot be re-keyed without a captured line and nothing has ever captured that branch.
# The rule is the OLD text, which needs no normaliser (Jev 0.91 over three candidates). It was
# SEEN TO FAIL on the real diff that caused the rc=4, core-agent d228a03, and seen to pass on
# winutils bd9a197, on the same diff with the ledger staged, and under its escape hatch.
kout=$(bash tools/hooks/log-key-drift-gate.sh 2>&1)
krc=$?
if [ $krc -eq 1 ]; then
  echo "$kout"
  echo
  echo "pre-commit REFUSED: tools/hooks/log-key-drift-gate.sh - the text or severity of a log"
  echo "message that the error ledger keys on changed, and the ledger is not in this commit."
  exit 1
elif [ $krc -ne 0 ]; then
  echo "NOTE: tools/hooks/log-key-drift-gate.sh DID NOT RUN (rc=$krc) - that is not a pass."
fi
exit 0
