--- a/src/xenbus/store.c
+++ b/src/xenbus/store.c
@@ -891,23 +891,64 @@
 #define TIME_MS(_ms)        (TIME_US((_ms) * 1000))
 #define TIME_S(_s)          (TIME_MS((_s) * 1000))
 #define TIME_RELATIVE(_t)   (-(_t))
 
 #define XENBUS_STORE_POLL_PERIOD 5
 
+// WAITING FOR XENSTORE MUST NOT HOLD THE STORE LOCK, AND MUST NOT WAIT FOREVER IN SILENCE.
+//
+// Upstream waits for its request while holding Context->Lock at DISPATCH_LEVEL, and
+// XENBUS_EVTCHN(Wait) is a pure _mm_pause() busy-spin (evtchn.c). So it burns a core with the
+// lock held for up to XENBUS_STORE_POLL_PERIOD seconds per iteration and, because a timeout
+// only logs and iterates, forever if the request never completes. About ten xenstore entry
+// points contend on that lock and every PV path in the guest goes through xenstore, so ONE
+// stuck request takes the whole guest down - measured 2026-09-12: qrexec, the PV console and
+// even the Windows event log went silent together while vCPUs spun, no dump, nothing to read.
+//
+// TWO CHANGES, AND THEY ARE DELIBERATELY THE ONLY TWO.
+//
+// 1. DROP THE LOCK BETWEEN POLLS. That is what stops one slow request freezing everything
+//    else; a request is completed by whoever polls next (StoreDpc runs __StorePoll
+//    independently), so this thread never needed the lock to make progress. IRQL stays at
+//    DISPATCH_LEVEL: the KeRaiseIrql above is annotated "Make sure we don't suspend" and it is
+//    load-bearing - SuspendTrigger -> SyncCapture queues a DPC on every CPU and spins until all
+//    run it, so staying at DISPATCH_LEVEL is what prevents a Xen suspend from landing while a
+//    request is in flight. Nothing re-sends a request across a suspend, and a half-sent one
+//    would have its tail written into a fresh ring, so that interlock is kept.
+//
+// 2. CRASH, LOUDLY, RATHER THAN GIVE UP QUIETLY. The tempting alternative - abandon the
+//    request and return NULL - is worse in three separate ways, all of them verified in this
+//    source: callers such as xenvif's FrontendWaitForBackendXenbusStateChange discard the
+//    status, so the guest would silently never get a network device; StoreWatchRemove and
+//    StoreTransactionEnd skip the cleanup that unlinks them and later reach BUG() anyway, via
+//    a watch whose Event points at a dead stack frame; and a request that is already PARTLY in
+//    the ring cannot be withdrawn at all - the ring is 1024 bytes against a 4096-byte payload,
+//    so xenstored would read the next request's header as this one's tail and the stream would
+//    be desynchronised permanently. A bugcheck has none of those failure modes, and unlike the
+//    silent wedge it leaves a CRASH DUMP naming this site - which is the only reason the
+//    original stall took days to identify.
+//
+// The deadline is therefore set where reaching it can only mean "genuinely broken", not
+// "busy": a xenstore round trip is normally sub-millisecond, and this is four orders of
+// magnitude above that. It also stays under the ~20 s DPC watchdog, so this bugcheck fires
+// before the generic 0x133 and the dump names xenstore instead of a nameless DPC.
+#define XENBUS_STORE_SPIN_US    100 // stall this long per poll, with the lock DROPPED
+#define XENBUS_STORE_TIMEOUT_S  15  // then bugcheck: loud, dumpable, never silent
+
 static PXENBUS_STORE_RESPONSE
 StoreSubmitRequest(
     IN  PXENBUS_STORE_CONTEXT   Context,
     IN  PXENBUS_STORE_REQUEST   Request
     )
 {
     PXENBUS_STORE_RESPONSE      Response;
     KIRQL                       Irql;
     ULONG                       Count;
     XENBUS_STORE_REQUEST_STATE  State;
     LARGE_INTEGER               Timeout;
+    LARGE_INTEGER               Deadline;
     NTSTATUS                    status;
 
     ASSERT3U(Request->State, ==, XENBUS_STORE_REQUEST_PREPARED);
 
     Request->Response = __StoreAllocate(sizeof (XENBUS_STORE_RESPONSE));
 
@@ -927,24 +968,57 @@
 
     Count = StorePollLocked(Context);
 
     KeMemoryBarrier();
     State = Request->State;
 
-    Timeout.QuadPart = TIME_RELATIVE(TIME_S(XENBUS_STORE_POLL_PERIOD));
+    // Poll, do not camp: the event-channel wait is a busy-spin, so ask it for nothing and do
+    // the waiting below with the lock dropped.
+    Timeout.QuadPart = 0;
+
+    KeQuerySystemTime(&Deadline);
+    Deadline.QuadPart += TIME_S(XENBUS_STORE_TIMEOUT_S);
 
     while (State != XENBUS_STORE_REQUEST_COMPLETED) {
-        status = XENBUS_EVTCHN(Wait,
-                               &Context->EvtchnInterface,
-                               Context->Channel,
-                               Count + 1,
-                               &Timeout);
-        if (status == STATUS_TIMEOUT)
-            Warning("TIMED OUT\n");
+        LARGE_INTEGER   Now;
+
+        (VOID) XENBUS_EVTCHN(Wait,
+                             &Context->EvtchnInterface,
+                             Context->Channel,
+                             Count + 1,
+                             &Timeout);
 
         Count = StorePollLocked(Context);
+
+        KeMemoryBarrier();
+        State = Request->State;
+
+        if (State == XENBUS_STORE_REQUEST_COMPLETED)
+            break;
+
+        KeQuerySystemTime(&Now);
+        if (Now.QuadPart >= Deadline.QuadPart) {
+            Error("XENSTORE STUCK: req_id %08x type %08x state %d index %d of %d\n",
+                  Request->Header.req_id,
+                  Request->Header.type,
+                  State,
+                  Request->Index,
+                  Request->Count);
+
+            // Deliberately fatal. See the note above XENBUS_STORE_TIMEOUT_S: every quieter
+            // option either lies to a caller that ignores it, leaks an object into a later
+            // bugcheck anyway, or corrupts the ring beyond recovery. This leaves a dump.
+            BUG("XENSTORE REQUEST NEVER COMPLETED");
+        }
+
+        // The change that matters: get off the lock. Another context's StorePollLocked
+        // completes this request just as well as this thread would, and meanwhile every other
+        // xenstore caller keeps running instead of piling up behind us.
+        KeReleaseSpinLockFromDpcLevel(&Context->Lock);
+        KeStallExecutionProcessor(XENBUS_STORE_SPIN_US);
+        KeAcquireSpinLockAtDpcLevel(&Context->Lock);
 
         KeMemoryBarrier();
         State = Request->State;
     }
 
     KeReleaseSpinLockFromDpcLevel(&Context->Lock);
