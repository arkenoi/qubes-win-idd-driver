     // it's possible that multiple threads hit the refcount==0 comparison simultaneously, locking is needed
     // can't use the client lock obviously since client's data is being freed
     // the global server lock isn't ideal but we would use it anyway to protect access to the client list...
+    // NOTHING TO RELEASE IF THE CLIENT IS ALREADY GONE. The public QpsDisconnectClient calls this
+    // with the result of QpsGetClientRaw, which returns NULL for a client that has just been
+    // unlinked - and InterlockedDecrement WRITES through the pointer (RefCount is at offset 0x78),
+    // so this is the same defect as the two thread entries at a different address.
+    if (!Client)
+        return;
+
     EnterCriticalSection(&Server->Lock);
     InterlockedDecrement(&Client->RefCount);
