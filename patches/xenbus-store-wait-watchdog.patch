     KIRQL                       Irql;
     ULONG                       Count;
     XENBUS_STORE_REQUEST_STATE  State;
     LARGE_INTEGER               Timeout;
+    LARGE_INTEGER               Start;
+    LARGE_INTEGER               NextWarn;
     NTSTATUS                    status;
 
     ASSERT3U(Request->State, ==, XENBUS_STORE_REQUEST_PREPARED);
 
     Request->Response = __StoreAllocate(sizeof (XENBUS_STORE_RESPONSE));
 
@@ -948,13 +975,19 @@
     State = Request->State;
 
     // Poll, do not camp: the event-channel wait is a busy-spin, so ask it for nothing and do
     // the waiting below with the lock dropped.
     Timeout.QuadPart = 0;
 
+    KeQuerySystemTime(&Start);
+    NextWarn.QuadPart = Start.QuadPart + TIME_S(XENBUS_STORE_WARN_S);
+
     while (State != XENBUS_STORE_REQUEST_COMPLETED) {
+        LARGE_INTEGER   Now;
+        ULONGLONG       Elapsed;
+
         (VOID) XENBUS_EVTCHN(Wait,
                              &Context->EvtchnInterface,
                              Context->Channel,
                              Count + 1,
                              &Timeout);
 
@@ -962,12 +995,41 @@
 
         KeMemoryBarrier();
         State = Request->State;
 
         if (State == XENBUS_STORE_REQUEST_COMPLETED)
             break;
+
+        KeQuerySystemTime(&Now);
+        Elapsed = (ULONGLONG)(Now.QuadPart - Start.QuadPart) / TIME_S(1);
+
+        if (Now.QuadPart >= NextWarn.QuadPart) {
+            // Loud well before fatal: this is the line that tells us whether 15 s is the right
+            // threshold on a real, loaded host, instead of us assuming it is.
+            Warning("XENSTORE SLOW: %I64u s waiting for req_id %08x type %08x state %d sent %d of %d\n",
+                    Elapsed,
+                    Request->Header.req_id,
+                    Request->Header.type,
+                    State,
+                    Request->Index,
+                    Request->Count);
+            NextWarn.QuadPart = Now.QuadPart + TIME_S(1);
+        }
+
+        if (Context->RequestTimeout != 0 &&
+            Elapsed >= (ULONGLONG)Context->RequestTimeout) {
+            Error("XENSTORE STUCK: %I64u s waiting for req_id %08x type %08x state %d sent %d of %d\n",
+                  Elapsed,
+                  Request->Header.req_id,
+                  Request->Header.type,
+                  State,
+                  Request->Index,
+                  Request->Count);
+
+            BUG("XENSTORE REQUEST NEVER COMPLETED");
+        }
 
         KeReleaseSpinLockFromDpcLevel(&Context->Lock);
         KeStallExecutionProcessor(XENBUS_STORE_SPIN_US);
         KeAcquireSpinLockAtDpcLevel(&Context->Lock);
 
         KeMemoryBarrier();
