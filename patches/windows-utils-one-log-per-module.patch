+// Flush a raw row that has not been ended by a newline fragment. Called with the lock held.
+static void _RawFlushUnlocked(void)
+{
+    DWORD written = 0;
+
+    if (g_RawLen == 0 || g_LogfileHandle == INVALID_HANDLE_VALUE)
+    {
+        g_RawLen = 0;
+        return;
+    }
