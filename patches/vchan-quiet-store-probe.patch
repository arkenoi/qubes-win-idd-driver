--- a/windows/src/init.c
+++ b/windows/src/init.c
@@ -143,7 +143,19 @@
 
     // test if the store entry exists; if not - wait a second time
     char buf[64];
-    if (XcStoreRead(xc_handle, xs_path_watch, sizeof(buf), buf) != ERROR_SUCCESS) {
+    // THIS READ IS A PROBE AND ITS FAILURE IS THE EXPECTED CASE - the status is discarded on the
+    // very next line, which is why the comment above says "if not". But XcStoreRead reports every
+    // failure at XLL_ERROR from inside xencontrol, so a peer that had simply gone away produced an
+    // ERROR line here for a question we only wanted the answer to. Measured on win11r-logvol
+    // 2026-10-08: a departed client wrote four of our error lines per call, and this was the first
+    // of them. The handle's log level belongs to the caller (XcSetLogLevel) and a message is
+    // emitted only when its level <= the current one, so 0 silences THIS read and nothing else; it
+    // is restored immediately. A real failure is still reported, with the path and the status, by
+    // the ring-ref read in libxenvchan_client_init and again by libvchan_client_init below.
+    XcSetLogLevel(xc_handle, (XENCONTROL_LOG_LEVEL)0);
+    BOOL entry_present = (XcStoreRead(xc_handle, xs_path_watch, sizeof(buf), buf) == ERROR_SUCCESS);
+    XcSetLogLevel(xc_handle, g_log_level);
+    if (!entry_present) {
         status = WaitForSingleObject(path_watch_event, 500);
         if (status != WAIT_OBJECT_0) {
             Log(XLL_WARNING, "Wait for xenstore (2) failed: 0x%x", status);
@@ -162,7 +174,12 @@
     ctrl->xs_path = NULL;
     ctrl->xenvchan = libxenvchan_client_init(g_logger, domain, xs_path, g_log_level);
     if (!ctrl->xenvchan) {
-        Log(XLL_ERROR, "libxenvchan_client_init(%u, %S) failed", domain, xs_path);
+        // ONE FAILURE, ONE REPORT. libxenvchan_client_init has ALREADY reported this at XLL_ERROR,
+        // with the full store path and the Win32 status - strictly more than this line carries, since
+        // the domain is inside that path. Repeating it here made one departed peer write two of its
+        // four error lines. This is not a failure made quieter: it is the same failure stopping being
+        // counted twice, and the layer that knows the detail is the one that keeps reporting it.
+        Log(XLL_DEBUG, "libxenvchan_client_init(%u, %S) failed - reported above", domain, xs_path);
         goto fail;
     }
 
