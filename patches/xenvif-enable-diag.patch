diff --git a/src/xenvif/frontend.c b/src/xenvif/frontend.c
index 086d0df..341192e 100644
--- a/src/xenvif/frontend.c
+++ b/src/xenvif/frontend.c
@@ -2088,8 +2088,27 @@ __FrontendUpdateHash(
 
     status = ControllerSetHashAlgorithm(Controller,
                                         NetifAlgorithm);
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        /* A backend that offers no control ring cannot be told anything about
+           hashing. When we are not asking for hashing there is no configuration
+           left to apply, so that is nothing to report - do not fail the device
+           over it.
+
+           Without this, ANY backend without feature-ctrl-ring makes the NIC
+           unusable: ControllerConnect skips creating the ring (goto done),
+           ControllerEnable sets Enabled anyway, and ControllerPutRequest then
+           finds a zeroed ring, where RING_FULL is trivially true (0 - 0 == 0),
+           and returns STATUS_INSUFFICIENT_RESOURCES. That propagates out of
+           FrontendEnable, so xennet's MiniportRestart fails and the adapter
+           ends at CM_PROB_FAILED_POST_START - purely because we could not say
+           "no hashing" to a peer that never offered hashing.
+           Measured against a MirageOS netback: qwt-enable-diag recorded
+           "UpdateHash-FAILED status=c000009a". */
+        if (NetifAlgorithm == XEN_NETIF_CTRL_HASH_ALGORITHM_NONE)
+            goto done;
+
         goto fail1;
+    }
 
     if (NetifAlgorithm == XEN_NETIF_CTRL_HASH_ALGORITHM_NONE)
         goto done;
@@ -2618,6 +2637,30 @@ FrontendDisconnect(
     Trace("<====\n");
 }
 
+/* QWT DIAGNOSTIC (not for upstream).
+ * FrontendEnable's failure is invisible on Qubes: Error() goes to DbgPrint -> xen.sys ->
+ * __outbytestring to port 0xE9/0x12, and neither port reaches anything readable on a Qubes
+ * host (xl dmesg and the stubdom log are both empty). Publish the outcome of each enable
+ * step into the FRONTEND's own xenstore directory instead, where the guest reads it back
+ * through the xeniface XenStore WMI interface - no dom0, no kernel debugger. */
+_IRQL_requires_(DISPATCH_LEVEL)
+static VOID
+FrontendEnableDiag(
+    IN  PXENVIF_FRONTEND    Frontend,
+    IN  const CHAR          *Stage,
+    IN  NTSTATUS            status
+    )
+{
+    (VOID) XENBUS_STORE(Printf,
+                        &Frontend->StoreInterface,
+                        NULL,
+                        __FrontendGetPath(Frontend),
+                        "qwt-enable-diag",
+                        "%s status=%08x",
+                        Stage,
+                        status);
+}
+
 _IRQL_requires_(DISPATCH_LEVEL)
 static NTSTATUS
 FrontendEnable(
@@ -2628,21 +2671,35 @@ FrontendEnable(
 
     Trace("====>\n");
 
+    FrontendEnableDiag(Frontend, "begin", 0);
+
     status = MacEnable(__FrontendGetMac(Frontend));
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "MacEnable-FAILED", status);
         goto fail1;
+    }
+    FrontendEnableDiag(Frontend, "MacEnable-ok", 0);
 
     status = ReceiverEnable(__FrontendGetReceiver(Frontend));
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "ReceiverEnable-FAILED", status);
         goto fail2;
+    }
+    FrontendEnableDiag(Frontend, "ReceiverEnable-ok", 0);
 
     status = TransmitterEnable(__FrontendGetTransmitter(Frontend));
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "TransmitterEnable-FAILED", status);
         goto fail3;
+    }
+    FrontendEnableDiag(Frontend, "TransmitterEnable-ok", 0);
 
     status = __FrontendUpdateHash(Frontend, &Frontend->Hash);
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "UpdateHash-FAILED", status);
         goto fail4;
+    }
+    FrontendEnableDiag(Frontend, "ENABLED-ok", 0);
 
     (VOID) FrontendNotifyMulticastAddresses(Frontend, TRUE);
 
diff --git a/src/xenvif/receiver.c b/src/xenvif/receiver.c
index fcd91ab..ac0ad9e 100644
--- a/src/xenvif/receiver.c
+++ b/src/xenvif/receiver.c
@@ -2868,8 +2868,25 @@ __ReceiverRingEnable(
     ReceiverRingFill(Ring);
 
     status = STATUS_INSUFFICIENT_RESOURCES;
-    if (!RING_FULL(&Ring->Front))
+    if (!RING_FULL(&Ring->Front)) {
+        /* QWT DIAGNOSTIC (not for upstream): this is the ONLY checked failure in the whole
+         * FrontendEnable path, and it is silent on Qubes. Publish how far the fill actually
+         * got - if posted < size the RX buffer/grant supply ran out; the exact shortfall
+         * says which. Written to the FRONTEND's own directory so the guest can read it. */
+        (VOID) XENBUS_STORE(Printf,
+                            &Receiver->StoreInterface,
+                            NULL,
+                            FrontendGetPath(Frontend),
+                            "qwt-rx-fill",
+                            "ring=%u size=%u req_prod=%u rsp_cons=%u posted=%u pushed=%u",
+                            Ring->Index,
+                            RING_SIZE(&Ring->Front),
+                            Ring->Front.req_prod_pvt,
+                            Ring->Front.rsp_cons,
+                            Ring->RequestsPosted,
+                            Ring->RequestsPushed);
         goto fail1;
+    }
 
     Ring->Enabled = TRUE;
 
