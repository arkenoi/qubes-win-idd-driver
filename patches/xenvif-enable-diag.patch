diff --git a/src/xenvif/frontend.c b/src/xenvif/frontend.c
index 44b6584..0cf7d1c 100644
--- a/src/xenvif/frontend.c
+++ b/src/xenvif/frontend.c
@@ -2636,6 +2636,29 @@ FrontendDisconnect(
     Trace("<====\n");
 }
 
+/* QWT DIAGNOSTIC (not for upstream). On a Qubes host xenvif's Error() output is
+ * unreachable - DbgPrint -> xen.sys -> __outbytestring to port 0xE9 or 0x12, and neither
+ * reaches anything readable (xl dmesg AND the stubdom log are empty). Publish each enable
+ * step into the FRONTEND's own xenstore directory, read back in-guest through the xeniface
+ * XenStore WMI interface. */
+_IRQL_requires_(DISPATCH_LEVEL)
+static VOID
+FrontendEnableDiag(
+    IN  PXENVIF_FRONTEND    Frontend,
+    IN  const CHAR          *Stage,
+    IN  NTSTATUS            status
+    )
+{
+    (VOID) XENBUS_STORE(Printf,
+                        &Frontend->StoreInterface,
+                        NULL,
+                        __FrontendGetPath(Frontend),
+                        "qwt-enable-diag",
+                        "%s status=%08x",
+                        Stage,
+                        status);
+}
+
 _IRQL_requires_(DISPATCH_LEVEL)
 static NTSTATUS
 FrontendEnable(
@@ -2646,21 +2669,35 @@ FrontendEnable(
 
     Trace("====>\n");
 
+    FrontendEnableDiag(Frontend, "begin", 0);
+
     status = MacEnable(__FrontendGetMac(Frontend));
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "MacEnable-FAILED", status);
         goto fail1;
+    }
+    FrontendEnableDiag(Frontend, "MacEnable-ok", 0);
 
     status = ReceiverEnable(__FrontendGetReceiver(Frontend));
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "ReceiverEnable-FAILED", status);
         goto fail2;
+    }
+    FrontendEnableDiag(Frontend, "ReceiverEnable-ok", 0);
 
     status = TransmitterEnable(__FrontendGetTransmitter(Frontend));
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "TransmitterEnable-FAILED", status);
         goto fail3;
+    }
+    FrontendEnableDiag(Frontend, "TransmitterEnable-ok", 0);
 
     status = __FrontendUpdateHash(Frontend, &Frontend->Hash);
-    if (!NT_SUCCESS(status))
+    if (!NT_SUCCESS(status)) {
+        FrontendEnableDiag(Frontend, "UpdateHash-FAILED", status);
         goto fail4;
+    }
+    FrontendEnableDiag(Frontend, "ENABLED-ok", 0);
 
     (VOID) FrontendNotifyMulticastAddresses(Frontend, TRUE);
 
diff --git a/src/xenvif/receiver.c b/src/xenvif/receiver.c
index fcd91ab..4a6a226 100644
--- a/src/xenvif/receiver.c
+++ b/src/xenvif/receiver.c
@@ -2868,8 +2868,22 @@ __ReceiverRingEnable(
     ReceiverRingFill(Ring);
 
     status = STATUS_INSUFFICIENT_RESOURCES;
-    if (!RING_FULL(&Ring->Front))
+    if (!RING_FULL(&Ring->Front)) {
+        /* QWT DIAGNOSTIC (not for upstream): publish how far the RX fill got. */
+        (VOID) XENBUS_STORE(Printf,
+                            &Receiver->StoreInterface,
+                            NULL,
+                            FrontendGetPath(Frontend),
+                            "qwt-rx-fill",
+                            "ring=%u size=%u req_prod=%u rsp_cons=%u posted=%u pushed=%u",
+                            Ring->Index,
+                            RING_SIZE(&Ring->Front),
+                            Ring->Front.req_prod_pvt,
+                            Ring->Front.rsp_cons,
+                            Ring->RequestsPosted,
+                            Ring->RequestsPushed);
         goto fail1;
+    }
 
     Ring->Enabled = TRUE;
 
