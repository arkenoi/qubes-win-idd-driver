+// qwt-one-connection: the device is ONE pipe handle opened with FILE_FLAG_OVERLAPPED (see
+// _tmain). A synchronous handle serialises its I/O, so TtyIn parked in a read would block
+// TtyOut's write; every device transfer therefore carries its own OVERLAPPED and event and
+// waits for its own completion, and a read and a write can be in flight together.
+static BOOL
+DeviceTransfer(
+    _In_ HANDLE         Handle,
+    _In_ BOOL           Write,
+    _Inout_updates_bytes_(Length) PVOID Buffer,
+    _In_ DWORD          Length,
+    _Out_opt_ LPDWORD   Transferred
+    )
+{
+    OVERLAPPED          Overlapped;
+    DWORD               Done;
+    BOOL                Success;
+
+    Done = 0;
+    ZeroMemory(&Overlapped, sizeof (Overlapped));
+    Overlapped.hEvent = CreateEvent(NULL, TRUE, FALSE, NULL);
+    if (Overlapped.hEvent == NULL) {
+        Success = FALSE;
+        goto done;
+    }
+
+    if (Write)
+        Success = WriteFile(Handle, Buffer, Length, NULL, &Overlapped);
+    else
+        Success = ReadFile(Handle, Buffer, Length, NULL, &Overlapped);
+
+    if (Success || GetLastError() == ERROR_IO_PENDING)
+        Success = GetOverlappedResult(Handle, &Overlapped, &Done, TRUE);
+
+    CloseHandle(Overlapped.hEvent);
+
+done:
+    if (Transferred != NULL)
+        *Transferred = Done;
+
+    return Success;
+}
